          "action": null,
          "args": {
            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# List of target spectra measured\ntarget_bases = [\n    '180856_527_x37.992_y25.32', \n    '180903_982_x37.992_y25.32', \n    '180911_397_x37.992_y25.32', \n    '180918_812_x37.992_y25.32', \n    '180926_212_x37.992_y25.32'\n]\n\n# Filter spectra to only include these bases\ndata = [s for s in spectra if s['base'] in target_bases]\n\nif len(data) < 5:\n    print(f\"Error: Expected 5 spectra, found {len(data)}\")\nelse:\n    # Extract intensities and raman shift (assuming all are the same)\n    intensities = np.array([s['intensity'] for s in data])\n    raman_shift = data[0]['raman_shift']\n\n    # Compute arithmetic mean\n    mean_intensity = np.mean(intensities, axis=0)\n\n    # Save the result\n    saved_path = save_result('averaged_spectrum', mean_intensity, raman_shift=raman_shift)\n    print(f\"Averaged spectrum saved to: {saved_path}\")\n\n    # Verification and plotting\n    plt.figure(figsize=(8, 6))\n    for i, s in enumerate(data):\n        plt.plot(s['raman_shift'], s['intensity'], alpha=0.3, label=f'Shot {i+1}')\n    plt.plot(raman_shift, mean_intensity, 'k-', linewidth=2, label='Mean')\n    plt.xlabel('Raman Shift (cm-1)')\n    plt.ylabel('Intensity')\n    plt.title('Comparison of individual shots and averaged spectrum')\n    plt.legend()\n    plt.grid(True)\n\n    print(f\"Max intensity (single): {np.max(intensities)}\")\n    print(f\"Max intensity (mean): {np.max(mean_intensity)}\")\n    print(f\"Mean array shape: {mean_intensity.shape}\")\n",
