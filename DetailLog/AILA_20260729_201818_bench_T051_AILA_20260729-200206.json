          "args": {
            "code": "import numpy as np\nfrom scipy.signal import find_peaks\n\n# Load data from files variable (injected by tool)\ndata_a = files[0][\"table\"]\ndata_b = files[1][\"table\"]\n\nx_a = data_a[\"raman_shift_cm-1\"]\ny_a = data_a[\"intensity\"]\nx_b = data_b[\"raman_shift_cm-1\"]\ny_b = data_b[\"intensity\"]\n\n# Peak detection. Using a modest height threshold to avoid noise spikes.\n# Since the mean intensity is ~76 and max is ~1061, let's use prominence or height.\npeaks_a, props_a = find_peaks(y_a, height=np.mean(y_a)*1.5, prominence=20)\npeaks_b, props_b = find_peaks(y_b, height=np.mean(y_b)*1.5, prominence=20)\n\npos_a = x_a[peaks_a]\npos_b = x_b[peaks_b]\n\n# Pair peaks: for each peak in A, find the closest peak in B within 30 cm-1\nresults = []\nfor p_a in pos_a:\n    diffs = np.abs(pos_b - p_a)\n    idx = np.argmin(diffs)\n    if diffs[idx] < 30: # Threshold for \"corresponding\"\n        shift = pos_b[idx] - p_a\n        if abs(shift) >= 5:\n            results.append((p_a, pos_b[idx], shift))\n\nprint(\"Significant peak shifts (>= 5 cm-1):\")\nfor res in results:\n    print(f\"Peak A: {res[0]:.2f} | Peak B: {res[1]:.2f} | Shift: {res[2]:.2f}\")\n\n# Plot for internal verification (will be saved as image)\nimport matplotlib.pyplot as plt\nplt.figure(figsize=(10, 6))\nplt.plot(x_a, y_a, label='T051_a')\nplt.plot(x_b, y_b, label='T051_b')\nplt.scatter(pos_a, y_a[peaks_a], color='red', marker='v', label='Peaks A')\nplt.scatter(pos_b, y_b[peaks_b], color='blue', marker='^', label='Peaks B')\nplt.xlabel('Raman Shift (cm-1)')\nplt.ylabel('Intensity')\nplt.legend()\nplt.title('Comparison of T051_a and T051_b')\nplt.grid(True)\nplt.savefig('spectra_comparison.png')\n",
