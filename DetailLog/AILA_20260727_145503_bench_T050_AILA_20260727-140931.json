          "args": {
            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data from the attached file\ndata = files[0]['table']\nx = data['x_mm']\ny = data['y_mm']\nshift = data['raman_shift_cm-1']\nintensity = data['intensity']\n\n# Find unique positions\nunique_coords = np.unique(np.stack([x, y], axis=1), axis=0)\nsorted_x = np.sort(np.unique(x))\nsorted_y = np.sort(np.unique(y))\n\nif len(sorted_x) != 3 or len(sorted_y) != 3:\n    print(f\"Warning: Expected a 3x3 map, but found {len(sorted_x)}x{len(sorted_y)}\")\n\n# Extract intensity closest to 1000 cm-1 for each position\nheatmap_data = np.zeros((len(sorted_y), len(sorted_x)))\n\nfor i, ux in enumerate(sorted_x):\n    for j, uy in enumerate(sorted_y):\n        # Mask data for this specific pixel\n        mask = (x == ux) & (y == uy)\n        pos_shift = shift[mask]\n        pos_int = intensity[mask]\n        \n        if len(pos_shift) > 0:\n            # Find index of value closest to 1000 cm-1\n            idx = np.argmin(np.abs(pos_shift - 1000))\n            heatmap_data[j, i] = pos_int[idx]\n        else:\n            heatmap_data[j, i] = np.nan\n\n# Plotting the heatmap\nplt.figure(figsize=(6, 5))\nim = plt.imshow(heatmap_data, origin='lower', extent=[sorted_x[0], sorted_x[-1], sorted_y[0], sorted_y[-1]], cmap='viridis')\nplt.colorbar(im, label='Intensity at ~1000 cm-1')\nplt.xlabel('X position (mm)')\nplt.ylabel('Y position (mm)')\nplt.title('Spatial Distribution of Intensity @ 1000 cm-1 (T050)')\nplt.xticks(sorted_x)\nplt.yticks(sorted_y)\n\n# Annotate the values on the plot\nfor i in range(len(sorted_x)):\n    for j in range(len(sorted_y)):\n        val = heatmap_data[j, i]\n        plt.text(sorted_x[i], sorted_y[j], f'{val:.1f}', ha='center', va='center', color='white' if val < np.mean(heatmap_data) else 'black')\n\nplt.tight_layout()\nplt.show()\n\nprint(\"Heatmap values (X columns, Y rows):\")\nprint(heatmap_data)\n",
