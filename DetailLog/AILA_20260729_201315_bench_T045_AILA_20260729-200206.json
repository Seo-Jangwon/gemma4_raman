            "code": "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.signal import find_peaks\n\ndef get_peaks(x, y, prominence=10):\n    # Basic peak detection\n    indices, properties = find_peaks(y, prominence=prominence)\n    return x[indices]\n\n# Load files\nt045 = files[0][\"table\"] if files[0][\"filename\"] == \"T045.csv\" else files[1][\"table\"]\nref = files[1][\"table\"] if files[0][\"filename\"] == \"T045.csv\" else files[0][\"table\"]\n\nx_t045 = t045[\"raman_shift_cm-1\"]\ny_t045 = t045[\"intensity\"]\nx_ref = ref[\"raman_shift_cm-1\"]\ny_ref = ref[\"intensity\"]\n\n# Detect peaks (tuning prominence based on stats: max is ~1060, mean is ~76)\npeaks_t045 = get_peaks(x_t045, y_t045, prominence=20)\npeaks_ref = get_peaks(x_ref, y_ref, prominence=20)\n\n# Match peaks within 3 cm-1\nmatched_peaks = []\nfor p_ref in peaks_ref:\n    # Find if any peak in t045 is within 3 cm-1 of p_ref\n    diffs = np.abs(peaks_t045 - p_ref)\n    if np.min(diffs) <= 3:\n        matched_peaks.append((p_ref, peaks_t045[np.argmin(diffs)]))\n\nmatch_ratio = (len(matched_peaks) / len(peaks_ref)) * 100 if len(peaks_ref) > 0 else 0\n\nprint(f\"Reference Peaks: {peaks_ref}\")\nprint(f\"Measured Peaks: {peaks_t045}\")\nprint(f\"Matched Pairs (Ref, Measured): {matched_peaks}\")\nprint(f\"Match Ratio: {match_ratio:.2f}%\")\n\n# Plotting for verification/output\nplt.figure(figsize=(12, 6))\nplt.plot(x_ref, y_ref, label='Reference', alpha=0.7)\nplt.plot(x_t045, y_t045, label='Measured', alpha=0.7)\nplt.scatter(peaks_ref, y_ref[np.isin(x_ref, peaks_ref)], color='blue', marker='v', label='Ref Peaks')\nplt.scatter(peaks_t045, y_t045[np.isin(x_t045, peaks_t045)], color='red', marker='^', label='Meas Peaks')\nplt.title(f\"Spectrum Comparison - Match Ratio: {match_ratio:.2f}%\")\nplt.xlabel(\"Raman Shift (cm-1)\")\nplt.ylabel(\"Intensity\")\nplt.legend()\nplt.grid(True)\nplt.savefig('spectrum_comparison.png')\n",
