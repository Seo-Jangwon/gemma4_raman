            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# spectra is provided by the environment\n# Let's plot all of them and check peak intensities\nplt.figure(figsize=(10, 6))\npeak_intensities = []\nbackground_levels = []\n\nfor s in spectra:\n    x = s['raman_shift']\n    y = s['intensity']\n    plt.plot(x, y, label=s['title'])\n    \n    # Simple way to estimate background: average of the first 50 points (usually low Raman shift)\n    bg = np.mean(y[:50])\n    background_levels.append(bg)\n    \n    # Find the maximum peak intensity in a typical Raman region (excluding the Rayleigh line)\n    # Assuming x is calibrated and we avoid the 0 cm-1 region if possible, or just find global max\n    max_val = np.max(y)\n    peak_intensities.append(max_val)\n\nplt.xlabel('Raman Shift (cm-1)')\nplt.ylabel('Intensity')\nplt.title('Sequential Spectra at Same Position')\nplt.legend()\nplt.savefig('sequential_spectra.png')\n\nprint(f\"Peak Intensities: {peak_intensities}\")\nprint(f\"Background Levels: {background_levels}\")\n",
