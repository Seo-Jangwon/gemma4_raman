        {
          "step": 11,
          "name": "run_analysis",
          "action": null,
          "args": {
            "code": "\nimport numpy as np\n\npeak_pos = 1001\nintensities = []\n\nfor s in spectra:\n    x = s['raman_shift']\n    y = s['intensity']\n    # Find index of shift closest to peak_pos\n    idx = np.argmin(np.abs(x - peak_pos))\n    val = y[idx]\n    intensities.append(val)\n    print(f\"Spectrum {s['base']}: intensity at {x[idx]:.2f} cm-1 is {val:.2f}\")\n\nmean_val = np.mean(intensities)\nstd_val = np.std(intensities, ddof=1) # sample std dev\nrsd = (std_val / mean_val) * 100\n\nprint(f\"\\nMean intensity: {mean_val:.2f}\")\nprint(f\"Sample Std Dev: {std_val:.2f}\")\nprint(f\"Relative Standard Deviation (RSD): {rsd:.4f}%\")\n",
