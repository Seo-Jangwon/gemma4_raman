            "code": "import numpy as np\n\n# We want to find the 3 highest intensity peaks in ps_clean.csv\n# Assuming files are already injected into the environment\nfor f in files:\n    if f['filename'] == 'ps_clean.csv':\n        target_file = f\n        break\n\nif target_file is None:\n    print(\"File ps_clean.csv not found in injected files.\")\nelse:\n    table = target_file['table']\n    cols = target_file['columns']\n    print(f\"Columns: {cols}\")\n    \n    # Identify Raman shift and Intensity columns\n    # Common names are 'raman_shift', 'shift', 'intensity', 'counts'\n    x_col = None\n    y_col = None\n    for col in cols:\n        if 'shift' in col.lower() or 'cm-1' in col.lower():\n            x_col = col\n        elif 'int' in col.lower() or 'count' in col.lower():\n            y_col = col\n    \n    if x_col and y_col:\n        x = table[x_col]\n        y = table[y_col]\n        \n        # Find peaks. A simple way is to find local maxima.\n        # Since it's a 'clean' spectrum, we can look for the absolute highest points\n        # and their corresponding X values. \n        # However, the user wants \"peaks\", which typically means local maxima.\n        \n        peaks = []\n        for i in range(1, len(y) - 1):\n            if y[i] > y[i-1] and y[i] > y[i+1]:\n                peaks.append((x[i], y[i]))\n        \n        # Sort peaks by intensity descending\n        peaks.sort(key=lambda p: p[1], reverse=True)\n        \n        print(\"Top 3 Peaks:\")\n        for i in range(min(3, len(peaks))):\n            print(f\"{i+1}. Position: {peaks[i][0]:.2f} cm-1, Intensity: {peaks[i][1]:.2f}\")\n    else:\n        print(\"Could not identify Raman shift and intensity columns.\")\n",
