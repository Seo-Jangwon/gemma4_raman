            "code": "\nimport numpy as np\n\n# Extract intensities at ~1001 cm-1 from the spectra\nintensities = []\ntarget_shift = 1001\n\nfor s in spectra:\n    if s['raman_shift'] is not None:\n        # Find index of value closest to 1001\n        idx = np.argmin(np.abs(s['raman_shift'] - target_shift))\n        intensities.append(s['intensity'][idx])\n\nif len(intensities) >= 5:\n    # We only need the last 5 measurements as requested\n    data = np.array(intensities[-5:])\n    mean_val = np.mean(data)\n    std_val = np.std(data, ddof=1) # sample standard deviation\n    rsd = (std_val / mean_val) * 100 if mean_val != 0 else 0\n    \n    print(f\"Intensities at {target_shift} cm-1: {data}\")\n    print(f\"Mean: {mean_val:.2f}\")\n    print(f\"Sample Std Dev: {std_val:.2f}\")\n    print(f\"Relative Standard Deviation (RSD): {rsd:.2f}%\")\nelse:\n    print(f\"Not enough spectra found. Found {len(intensities)}.\")\n",
