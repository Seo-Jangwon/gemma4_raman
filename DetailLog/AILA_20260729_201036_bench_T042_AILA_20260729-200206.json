            "code": "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.signal import find_peaks\n\n# Load data from attached file\nx = files[0][\"table\"][\"raman_shift_cm-1\"]\ny = files[0][\"table\"][\"intensity\"]\n\n# Baseline subtraction (simple linear or just offset) \n# To be more robust, let's subtract the minimum intensity as a simple baseline correction\ny_corrected = y - np.min(y)\n\n# Find peaks\n# distance=10 to avoid too many close-by spikes, prominence=10 to filter noise\npeaks, properties = find_peaks(y_corrected, distance=10, prominence=10)\npeak_x = x[peaks]\npeak_y = y_corrected[peaks]\n\n# Get the 7 major peaks (highest intensity)\ntop_indices = np.argsort(peak_y)[-7:][::-1]\nmajor_peak_x = peak_x[top_indices]\nmajor_peak_y = peak_y[top_indices]\n\n# Sort them by x position for the report\nsort_idx = np.argsort(major_peak_x)\nfinal_peaks_x = major_peak_x[sort_idx]\nfinal_peaks_y = major_peak_y[sort_idx]\n\nprint(\"Major Peaks Found:\")\nfor px, py in zip(final_peaks_x, final_peaks_y):\n    print(f\"Position: {px:.2f} cm-1, Intensity (relative to min): {py:.2f}\")\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, label='Original Spectrum')\nplt.plot(x, y_corrected, label='Baseline Corrected', alpha=0.7)\nplt.plot(final_peaks_x, final_peaks_y + np.min(y), \"rx\", label='Major Peaks')\nplt.xlabel('Raman Shift (cm-1)')\nplt.ylabel('Intensity')\nplt.title('Polystyrene Raman Spectrum - Major Peak Detection')\nplt.legend()\nplt.grid(True)\nplt.savefig('polystyrene_peaks.png')\n",
