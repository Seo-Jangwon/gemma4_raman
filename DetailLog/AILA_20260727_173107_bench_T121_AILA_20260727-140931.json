            "code": "import numpy as np\n\n# Data from T121.csv\nt121 = files[0][\"table\"] # Assuming index based on order of file_ids passed, but it's safer to use names if available or check how they are loaded. \n# Wait, run_analysis provides 'files' as a list of dicts. I need to find T121 and peak_library among them.\n\nt121_data = None\nlib_data = None\n\nfor f in files:\n    if \"T121.csv\" in f[\"filename\"]:\n        t121_data = f[\"table\"]\n    elif \"peak_library.csv\" in f[\"filename\"]:\n        lib_data = f[\"table\"]\n\nif t121_data is not None:\n    x = t121_data[\"raman_shift_cm-1\"]\n    y = t121_data[\"intensity\"]\n    peak_idx = np.argmax(y)\n    peak_pos = x[peak_idx]\n    peak_val = y[peak_idx]\n    print(f\"T121 Strongest Peak: {peak_pos:.2f} cm-1 (Intensity: {peak_val:.2f})\")\n\nif lib_data is not None:\n    materials = lib_data[\"material\"]\n    peaks = lib_data[\"peak_cm-1\"]\n    \n    # Look for the material with a peak closest to 520 or the found peak_pos\n    # Let's use the actual found peak_pos from T121\n    if t121_data is not None:\n        diffs = np.abs(peaks - peak_pos)\n        best_match_idx = np.argmin(diffs)\n        matched_material = materials[best_match_idx]\n        matched_peak = peaks[best_match_idx]\n        print(f\"Matched Material: {matched_material} (Library Peak: {matched_peak:.2f} cm-1)\")\n    else:\n        print(\"T121 data not found.\")\n",
