            "code": "import numpy as np\n\n# Load T121 data\nt121 = files[0][\"table\"] # Since I will pass file_ids, let's check which is which\n# Wait, the order in run_analysis depends on the list provided. \n# Let me be explicit about indices or names if possible.\n\n# better yet: loop through files and identify by filename\nt121_data = None\nlib_data = None\n\nfor f in files:\n    if 'T121' in f['filename']:\n        t121_data = {'x': f['table']['raman_shift_cm-1'], 'y': f['table']['intensity']}\n    elif 'peak_library' in f['filename']:\n        lib_data = f['table']\n\n# Find the peak near 520 cm-1 in T121\nx = t121_data['x']\ny = t121_data['y']\n\n# Mask for range around 520 (e.g., 500 to 540)\nmask = (x >= 500) & (x <= 540)\nx_sub = x[mask]\ny_sub = y[mask]\n\nidx_max = np.argmax(y_sub)\npeak_pos = x_sub[idx_max]\npeak_int = y_sub[idx_max]\n\nprint(f\"Strongest peak near 520 cm-1: {peak_pos:.2f} cm-1 with intensity {peak_int:.2f}\")\n\n# Now match with library\n# lib_data is a dict where keys are 'material' and 'peak_cm-1'\nmaterials = np.array(lib_data['material'])\npeaks = np.array(lib_data['peak_cm-1'])\n\n# Find the material whose peak is closest to our measured peak_pos\ndiffs = np.abs(peaks - peak_pos)\nbest_match_idx = np.argmin(diffs)\nmatched_material = materials[best_match_idx]\nmatched_peak = peaks[best_match_idx]\n\nprint(f\"Matched Material: {matched_material}\")\nprint(f\"Library Peak Position: {matched_peak:.2f} cm-1\")\nprint(f\"Difference: {abs(peak_pos - matched_peak):.4f} cm-1\")\n",
