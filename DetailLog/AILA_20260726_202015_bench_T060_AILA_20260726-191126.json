            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Get the last two measurements\ns1 = spectra[-2] # x=37\ns2 = spectra[-1] # x=38\n\nx1, y1 = s1['raman_shift'], s1['intensity']\nx2, y2 = s2['raman_shift'], s2['intensity']\n\n# Align to a common axis (interpolate y2 onto x1)\ny2_interp = np.interp(x1, x2, y2)\n\n# Normalize to vector length 1 (L2 norm)\nnorm1 = np.linalg.norm(y1)\nnorm2 = np.linalg.norm(y2_interp)\n\ny1_n = y1 / norm1 if norm1 > 0 else y1\ny2_n = y2_interp / norm2 if norm2 > 0 else y2_interp\n\n# Cosine Similarity (Dot product of L2-normalized vectors)\nsimilarity = np.dot(y1_n, y2_n)\nprint(f\"Cosine Similarity between {s1['title']} and {s2['title']}: {similarity:.4f}\")\n\n# Plotting\nplt.figure(figsize=(8, 5))\nplt.plot(x1, y1_n, label=f\"Pos 1: {s1['title']}\")\nplt.plot(x1, y2_n, label=f\"Pos 2: {s2['title']}\")\nplt.title(f\"Normalized Spectra Comparison\\nCosine Similarity: {similarity:.4f}\")\nplt.xlabel(\"Raman Shift (cm-1)\")\nplt.ylabel(\"Normalized Intensity\")\nplt.legend()\nplt.grid(True)\nplt.show()\n",
