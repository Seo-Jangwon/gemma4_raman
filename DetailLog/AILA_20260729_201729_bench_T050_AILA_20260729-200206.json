            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data from T050.csv\ndata = files[0]['table']\nx = data['x_mm']\ny = data['y_mm']\nshift = data['raman_shift_cm-1']\nintensity = data['intensity']\n\n# Unique positions\nunique_pos = []\nfor px, py in zip(x, y):\n    if (px, py) not in unique_pos:\n        unique_pos.append((px, py))\n\n# Sort positions to create a grid\n# x-coords sorted, then y-coords sorted\nsorted_x = sorted(list(set(x)))\nsorted_y = sorted(list(set(y)))\n\nheatmap_data = np.zeros((len(sorted_y), len(sorted_x)))\n\nfor i, py in enumerate(sorted_y):\n    for j, px in enumerate(sorted_x):\n        # Mask for current position\n        mask = (x == px) & (y == py)\n        pos_shift = shift[mask]\n        pos_intensity = intensity[mask]\n        \n        # Find index of value closest to 1000 cm-1\n        idx = np.abs(pos_shift - 1000).argmin()\n        val = pos_intensity[idx]\n        heatmap_data[i, j] = val\n\nprint(f\"Positions found: {len(sorted_x)}x{len(sorted_y)}\")\nprint(\"Heatmap values:\\n\", heatmap_data)\n\n# Plotting the heatmap\nplt.figure(figsize=(6, 5))\nim = plt.imshow(heatmap_data, origin='lower', extent=[min(sorted_x), max(sorted_x), min(sorted_y), max(sorted_y)], cmap='viridis')\nplt.colorbar(im, label='Intensity at ~1000 cm-1')\nplt.xlabel('X (mm)')\nplt.ylabel('Y (mm)')\nplt.title('Spatial Distribution of Intensity at 1000 cm-1')\nplt.show()\n",
