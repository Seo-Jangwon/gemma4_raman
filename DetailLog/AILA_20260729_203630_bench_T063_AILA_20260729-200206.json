            "code": "\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.optimize import curve_fit\n\ndef remove_spikes(y, threshold=5):\n    y_copy = np.copy(y)\n    for i in range(1, len(y)-1):\n        if abs(y[i] - (y[i-1] + y[i+1])/2) > threshold * np.std(y):\n            y_copy[i] = (y[i-1] + y[i+1]) / 2\n    return y_copy\n\ndef poly_baseline(x, *coeffs):\n    return np.polyval(coeffs, x)\n\ndef baseline_correct(x, y, order=5):\n    # Simple iterative polynomial fit for background subtraction\n    y_fit = np.copy(y)\n    for _ in range(10):\n        coeffs = np.polyfit(x, y_fit, order)\n        baseline = np.polyval(coeffs, x)\n        y_fit = np.maximum(y - baseline, 0)\n    return y_fit\n\ndef vector_normalize(y):\n    norm = np.linalg.norm(y)\n    if norm == 0: return y\n    return y / norm\n\nintensities_1001 = []\npositions_x = []\n\ntarget_shift = 1001\n\nfor spec in spectra:\n    x = spec['raman_shift']\n    y = spec['intensity']\n    pos_x = spec['x']\n    \n    # Processing pipeline\n    y_despiked = remove_spikes(y)\n    y_bc = baseline_correct(x, y_despiked, order=5)\n    y_norm = vector_normalize(y_bc)\n    \n    # Find index of 1001 cm-1\n    idx = np.argmin(np.abs(x - target_shift))\n    val = y_norm[idx]\n    \n    intensities_1001.append(val)\n    positions_x.append(pos_x)\n\n# Plotting\nplt.figure(figsize=(8, 5))\nplt.plot(positions_x, intensities_1001, marker='o', linestyle='-', color='b')\nplt.xlabel('X position (mm)')\nplt.ylabel('Normalized Intensity at 1001 cm-1')\nplt.title('Intensity of 1001 cm-1 peak vs Position')\nplt.grid(True)\nplt.savefig('intensity_profile_1001.png')\n\nprint(f\"Positions: {positions_x}\")\nprint(f\"Intensities at 1001: {intensities_1001}\")\n",
