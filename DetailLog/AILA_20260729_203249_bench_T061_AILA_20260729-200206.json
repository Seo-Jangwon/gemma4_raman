          "args": {
            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# We use the spectra list provided by the environment\n# Filter for the three measurements we just took at (38.0, 25.25)\ntarget_spectra = [s for s in spectra if s['x'] == 38.0 and s['y'] == 25.25]\n\n# Sort by power to ensure order: 20%, 60%, 100%\ntarget_spectra.sort(key=lambda s: s['power'])\n\npowers = []\nsnrs = []\n\nfor s in target_spectra:\n    y = s['intensity']\n    x = s['raman_shift']\n    \n    # Simple SNR calculation: \n    # Signal = Max peak height (assuming the highest peak is our signal)\n    # Noise = Std dev of a region without peaks. \n    # Let's use a slice that is usually quiet, e.g., indices 100-200 if Raman shift range allows.\n    # Or better: find the max and then take noise from the edges or a known flat region.\n    \n    peak_val = np.max(y)\n    baseline_val = np.mean(y[:100]) # Use first 100 points as noise reference\n    noise_std = np.std(y[:100])\n    \n    signal_amplitude = peak_val - baseline_val\n    snr = signal_amplitude / noise_std if noise_std != 0 else 0\n    \n    powers.append(s['power'])\n    snrs.append(snr)\n    print(f\"Power: {s['power']}%, Peak: {peak_val:.1f}, Noise Std: {noise_std:.2f}, SNR: {snr:.2f}\")\n\nplt.figure(figsize=(6, 4))\nplt.plot(powers, snrs, 'o-', color='blue', linewidth=2)\nplt.xlabel('Laser Power (%)')\nplt.ylabel('Signal-to-Noise Ratio (SNR)')\nplt.title('SNR vs Laser Power')\nplt.grid(True)\nplt.savefig('snr_vs_power.png')\n\nprint(f\"Final SNRs: {snrs}\")\n",
