            "code": "import numpy as np\nfrom scipy.signal import find_peaks\n\ndef get_peaks(x, y):\n    # Use a height threshold to avoid noise; since mean is ~76 and max is ~1061, \n    # let's use something like 2*mean or similar, but better just look for local maxima.\n    # Given the request, I'll find peaks with prominence to be robust.\n    peaks, properties = find_peaks(y, height=100, prominence=10)\n    return x[peaks]\n\nfiles_data = {f['filename']: (f['table']['raman_shift_cm-1'], f['table']['intensity']) for f in files}\n\nx_a, y_a = files_data['T051_a.csv']\nx_b, y_b = files_data['T051_b.csv']\n\npeaks_a = get_peaks(x_a, y_a)\npeaks_b = get_peaks(x_b, y_b)\n\ndiffs = []\nfor pa in peaks_a:\n    # Find the closest peak in b\n    idx_b = np.argmin(np.abs(peaks_b - pa))\n    pb = peaks_b[idx_b]\n    diff = abs(pa - pb)\n    if diff >= 5:\n        diffs.append((pa, pb, diff))\n\nprint(\"Significant peak shifts (>= 5 cm-1):\")\nfor a, b, d in diffs:\n    print(f\"Peak A: {a:.2f}, Peak B: {b:.2f}, Diff: {d:.2f}\")\n",
