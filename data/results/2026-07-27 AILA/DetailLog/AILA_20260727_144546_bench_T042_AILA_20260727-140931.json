            "code": "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.signal import find_peaks\n\n# Access the data from the attached file\nx = files[0]['table']['raman_shift_cm-1']\ny = files[0]['table']['intensity']\n\n# Find peaks\n# We use a reasonable height threshold to avoid noise and a distance to separate nearby peaks\npeaks, properties = find_peaks(y, height=100, distance=10)\n\n# Sort peaks by intensity (height) in descending order\npeak_heights = properties['peak_heights']\nsorted_indices = np.argsort(peak_heights)[::-1]\n\ntop_7_indices = sorted_indices[:7]\ntop_7_x = x[peaks[top_7_indices]]\ntop_7_y = y[peaks[top_7_indices]]\n\n# Sort them by Raman shift for better reporting\nsort_by_shift = np.argsort(top_7_x)\nfinal_x = top_7_x[sort_by_shift]\nfinal_y = top_7_y[sort_by_shift]\n\nprint(\"Top 7 major peaks found in T042.csv:\")\nfor i in range(len(final_x)):\n    print(f\"Peak {i+1}: Position = {final_x[i]:.2f} cm-1, Intensity = {final_y[i]:.2f}\")\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, label='Polystyrene Spectrum')\nplt.scatter(final_x, final_y, color='red', marker='x', label='Major Peaks')\nfor i in range(len(final_x)):\n    plt.annotate(f\"{final_x[i]:.1f}\", (final_x[i], final_y[i]), textcoords=\"offset points\", xytext=(0,10), ha='center')\n\nplt.xlabel('Raman Shift (cm-1)')\nplt.ylabel('Intensity')\nplt.title('Polystyrene Spectrum - Top 7 Peaks')\nplt.legend()\nplt.grid(True)\nplt.show()",
