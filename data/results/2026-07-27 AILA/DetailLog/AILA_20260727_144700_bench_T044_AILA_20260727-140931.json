            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data from attached file\nf = files[0]\nx = f['table']['raman_shift_cm-1']\ny = f['table']['intensity']\n\n# Define interval of interest\nx_min, x_max = 980, 1020\nmask = (x >= x_min) & (x <= x_max)\nx_roi = x[mask]\ny_roi = y[mask]\n\n# Find peak maximum and minimum for baseline\npeak_idx = np.argmax(y_roi)\ny_max = y_roi[peak_idx]\nx_max_pos = x_roi[peak_idx]\n\n# Estimate baseline as the average of the edges of the ROI\nbaseline = (y_roi[0] + y_roi[-1]) / 2\nheight = y_max - baseline\nhalf_max = baseline + height / 2\n\n# Find crossings for FWHM\n# Search left of peak\nleft_idx = peak_idx\nwhile left_idx > 0 and y_roi[left_idx] > half_max:\n    left_idx -= 1\n# Linear interpolation for more precision\nx_left = x_roi[left_idx] + (x_roi[left_idx+1] - x_roi[left_idx]) * \\\n         (half_max - y_roi[left_idx]) / (y_roi[left_idx+1] - y_roi[left_idx])\n\n# Search right of peak\nright_idx = peak_idx\nwhile right_idx < len(y_roi) - 1 and y_roi[right_idx] > half_max:\n    right_idx += 1\nx_right = x_roi[right_idx-1] + (x_roi[right_idx] - x_roi[right_idx-1]) * \\\n          (half_max - y_roi[right_idx-1]) / (y_roi[right_idx] - y_roi[right_idx-1])\n\nfwhm = x_right - x_left\n\nprint(f\"Peak Position: {x_max_pos:.2f} cm-1\")\nprint(f\"Intensity Max: {y_max:.2f}\")\nprint(f\"Baseline: {baseline:.2f}\")\nprint(f\"FWHM: {fwhm:.3f} cm-1\")\n\nplt.figure(figsize=(8, 6))\nplt.plot(x_roi, y_roi, 'b-', label='Spectrum')\nplt.axhline(y=half_max, color='r', linestyle='--', label=f'Half Max ({half_max:.2f})')\nplt.axvline(x=x_left, color='g', linestyle=':', label=f'Left: {x_left:.2f}')\nplt.axvline(x=x_right, color='g', linestyle=':', label=f'Right: {x_right:.2f}')\nplt.title(f\"FWHM Calculation for Peak near 1000 cm-1\\nFWHM = {fwhm:.3f} cm-1\")\nplt.xlabel(\"Raman Shift (cm-1)\")\nplt.ylabel(\"Intensity\")\nplt.legend()\nplt.grid(True)\nplt.show()",
