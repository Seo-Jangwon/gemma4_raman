            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef detect_clipping(x, y):\n    # Find regions where the signal is constant at the maximum value for a few points\n    max_val = np.max(y)\n    clipped_indices = np.where(np.abs(y - max_val) < 1e-3)[0]\n    if len(clipped_indices) > 5: # threshold for 'flat'\n        return True, max_val\n    return False, max_val\n\n# Check the last few T files\ntarget_files = ['T128_5.csv', 'T128_4.csv', 'T128_3.csv', 'T128_2.csv', 'T128_1.csv']\nresults = []\n\nfor f in files:\n    if f['filename'] in target_files:\n        x = f['table']['raman_shift_cm-1']\n        y = f['table']['intensity']\n        is_clipped, mv = detect_clipping(x, y)\n        results.append((f['filename'], is_clipped, mv))\n\nprint(results)\n",
