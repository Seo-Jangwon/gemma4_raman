            "code": "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data from the first attached file\nfile = files[0]\nx = file[\"table\"][\"raman_shift_cm-1\"]\ny = file[\"table\"][\"intensity\"]\n\ndef polynomial_baseline(x, y, order=5, iterations=10):\n    \"\"\"Simplified iterative polynomial baseline subtraction.\"\"\"\n    current_y = y.copy()\n    for i in range(iterations):\n        # Fit polynomial to the current data\n        coeffs = np.polyfit(x, current_y, order)\n        baseline = np.polyval(coeffs, x)\n        \n        # To avoid fitting peaks, we only consider points that are \n        # below or near the baseline for the next fit\n        # Mask: True if the point is 'part of the baseline'\n        mask = current_y <= baseline * 1.05 # Allow a small margin\n        if np.sum(mask) < order + 1:\n            break\n        \n        # Refit using only masked points to better capture the floor\n        coeffs = np.polyfit(x[mask], current_y[mask], order)\n        baseline = np.polyval(coeffs, x)\n        \n        # Update current_y for next iteration's masking logic \n        # (though usually we keep original y and just refine the baseline)\n        current_y = y - baseline\n        \n    return baseline\n\n# Apply 5th order polynomial baseline correction\nbaseline = polynomial_baseline(x, y, order=5)\ny_corrected = y - baseline\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, label='Original Spectrum', color='gray', alpha=0.7)\nplt.plot(x, baseline, label='5th-order Polynomial Baseline', color='red', linestyle='--')\nplt.plot(x, y_corrected, label='Baseline Corrected', color='blue', linewidth=2)\n\nplt.xlabel('Raman Shift (cm$^{-1}$)')\nplt.ylabel('Intensity')\nplt.title('Baseline Correction for T038.csv (5th Order Polynomial)')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()\n\nprint(f\"Processing complete for {file['filename']}.\")\n",
