    run_analysis(code=import numpy as np
    from preprocessing import ipbsa
    
    # T115 is file 0, Reference Library is file 1
    t115_data = files[0]['table']
    ref_data = files[1]['table']
    
    x_t115 = t115_data['raman_shift_cm-1'].values
    y_t115_raw = t115_data['intensity'].values
    
    # Apply IPBSA
    y_t115_corr, _ = ipbsa(y_t115_raw, order=5)
    
    # Save corrected spectrum
    save_result('T115_corrected.csv', y_t115_corr, raman_shift_cm-1=x_t115)
    
    # Normalization and Comparison
    # Since sklearn is not allowed, we calculate cosine similarity manually: 
    # cos(theta) = (A . B) / (||A|| * ||B||)
    y_t115_norm = y_t115_corr / np.linalg.norm(y_t115_corr)
    
    unique_mats = list(set(ref_data['material']))
    best_sim = -1.0
    best_mat = ""
    
    for mat in unique_mats:
        mask = (ref_data['material'] == mat)
        sub_ref = ref_data[mask]
        # Average the intensity for this material across all its entries
        y_ref = np.mean(sub_ref['intensity'].values, axis=0)
        
        if len(y_ref) == len(y_t115_norm):
            y_ref_norm = y_ref / np.linalg.norm(y_ref)
            # Manual cosine similarity for 1D arrays
            sim = np.dot(y_t115_norm, y_ref_norm)
            if sim > best_sim:
                best_sim = sim
                best_mat = mat
    
    print(f"RESULT:{best_mat}")
    , file_ids=['2026-08-10/T115.csv', '2026-08-10/reference_library.csv'])
