    run_analysis(code=import numpy as np
    from preprocessing import ipbsa
    
    # Process T115.csv
    t115_data = files[0]['table']
    x_1 = t115_data['raman_shift_cm-1'].values
    y_1 = t115_data['intensity'].values
    y_1_corr, _ = ipbsa(y_1, order=5)
    
    # Save the result
    save_result('T115_corrected.csv', y_1_corr, raman_shift_cm-1=x_1)
    
    # Compare with Reference Library
    ref_data = files[1]['table']
    y_1_norm = y_1_corr / np.linalg.norm(y_1_corr)
    
    mats = list(set(ref_data['material']))
    best_score = -1.0
    winning_mat = ""
    
    for m in mats:
        mask = (ref_data['material'] == m)
        subset = ref_data[mask]
        y_ref = np.mean(subset['intensity'].values, axis=0)
        
        # Ensure length matches before dot product
        if len(y_ref) == len(y_1_norm):
            y_ref_n = y_ref / np.linalg.norm(y_ref)
            score = np.dot(y_1_norm, y_ref_n)
            if score > best_score:
                best_score = score
                winning_mat = m
    
    print("RESULT:", winning_mat)
