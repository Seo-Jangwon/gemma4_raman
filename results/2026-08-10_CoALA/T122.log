    run_analysis(code=import numpy as np
    
    # The files are injected into the 'files' list of dictionaries.
    # Based on the error "AttributeError: 'numpy.ndarray' object has no attribute 'values'", 
    # it means that columns like r_table['spectrum_id'] are already numpy arrays, not Pandas series.
    # We should use standard indexing or boolean masking directly on the numpy array.
    
    target_id = "2026-08-10/T122.csv"
    ref_id = "2026-08-10/reference_library.csv"
    
    # Locate indices in the 'files' list (which contains both files)
    t_idx = -1
    r_idx = -1
    for i, f in enumerate(files):
        if f['file_id'] == target_id:
            t_idx = i
        elif f['file_id'] == ref_id:
            r_idx = i
    
    # Data is located in the 'table' dictionary within each file dict.
    # table maps column name -> numpy array (as seen from the error)
    t_data = files[t_idx]['table']
    r_data = files[r_idx]['table']
    
    # Extract data
    y_target = t_data['intensity'] # This is an ndarray
    max_y_t = np.max(y_target) if np.max(y_target) > 0 else 1.0
    norm_target = y_target / max_y_t
    
    # Reference Data
    ids_arr = r_data['spectrum_id']
    mat_arr = r_data['material']
    ref_ints = r_data['intensity']
    
    best_dist = float('inf')
    best_id = None
    best_mat = ""
    
    unique_ids = np.unique(ids_arr)
    
    for sid in unique_ids:
        # Identify rows where the ID matches
        indices = np.where(ids_arr == sid)[0]
        subset_ints = ref_ints[indices]
        
        max_y_r = np.max(subset_ints) if np.max(subset_ints) > 0 else 1.0
        norm_ref = subset_ints / max_y_r
        
        # Calculate distance (Euclidean of normalized vectors)
        dist = np.linalg.norm(norm_target - norm_ref)
        
        if dist < best_dist:
            best_dist = dist
            best_id = sid
            best_mat = mat_arr[indices[0]]
    
    print(f"Match found: ID={best_id}, Mat={best_mat}, Dist={best_dist}")
    , file_ids=['2026-08-10/reference_library.csv', '2026-08-10/T122.csv'])
