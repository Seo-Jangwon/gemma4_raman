    run_analysis(code=import numpy as np
    from scipy.signal import find_peaks
    
    # The files are accessed via the 'files' list provided by the tool
    f = files[0]
    x = f['table']['raman_shift_cm-1']
    y = f['table']['intensity']
    
    # Calculate the range and prominence threshold
    y_range = np.max(y) - np.min(y)
    prom_thresh = 0.05 * y_range
    
    # Find peaks using scipy's find_peaks with specified prominence
    p, _ = find_peaks(y, prominence=prom_thresh)
    
    peak_x = x[p]
    peak_y = y[p]
    
    # Sort by intensity to find the 6 largest (since they have been filtered for prominence)
    # Note: "Largest by prominence" in this context refers to the magnitude above local minima.
    # If there are many, we pick those with highest value in 'y'.
    if len(p) > 6:
        # Get indices of top 6 peaks based on intensity (height)
        top_idx = np.argsort(peak_y)[-6:]
        # Sort these selected peak positions for the final report
        sorted_final_idx = sorted(top_idx)
        res_x = peak_x[sorted_final_idx]
        res_y = peak_y[sorted_final_idx]
    else:
        # If 6 or fewer peaks are found, we simply order them by position
        sorted_idx = np.argsort(peak_x)
        res_x = peak_x[sorted_idx]
        res_y = peak_y[sorted_idx]
    
    print("Final positions:", res_x.tolist())
    print("Final intensities:", res_y.tolist())
    , file_ids=['2026-08-10/T043.csv'])
