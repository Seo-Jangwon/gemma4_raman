    file_data = files[0]['table']
    x = file_data['raman_shift_cm-1'].values
    y = file_data['intensity'].values
    
    # Calculate threshold
    y_range = np.max(y) - np.min(y)
    prom_thresh = 0.05 * y_range
    
    # find_peaks with the specified prominence
    p, props = find_peaks(y, prominence=prom_thresh)
    
    # Extract peak information
    peak_x = x[p]
    peak_y = y[p]
    
