    ref_x = ref_data['raman_shift_cm-1'].values
    ref_y = ref_data['intensity'].values
    
    similarities = []
    # The 'spectra' list items are dictionaries from the measurement records.
    for s in spectra:
        # The keys might be different depending on how they were loaded, 
        # but usually for a standard acquisition it is 'raman_shift' and 'intensity'.
        # To be safe, we check for common keys.
