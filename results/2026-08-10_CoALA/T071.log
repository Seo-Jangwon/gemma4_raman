        y_key = 'intensity' if 'intensity' in s else 'y'
        
        curr_x = s[x_key]
        curr_y = s[y_key]
        
        # Handle cases where curr_x might be a single value (not the case here) 
        # or has different length than ref_x.
        # Interpolate current spectrum onto reference axis.
        if isinstance(curr_x, np.ndarray):
            query_y = np.interp(ref_x, curr_x, curr_y)
        else:
            # This case shouldn't happen with standard measurement files
            query_y = curr_y
    
