    y_t = t125_f['table']['intensity']
    
    # Baseline correction and normalization for T125
    y_t_corr, _ = ipbsa(y_t, order=4)
    def normalize(y):
        ymin, ymax = np.min(y), np.max(y)
        if ymax == ymin: return y - ymin
        return (y - ymin) / (ymax - ymin)
    
    y_t_norm = normalize(y_t_corr)
    
