    run_analysis(code=import numpy as np
    
    # The files list contains the data for the provided file_ids.
    # Each element of `files` is a dictionary with a 'table' key.
    # Since only one file was specified in the tool call, we use it directly.
    target_data = files[0]['table']
    x = target_data['raman_shift_cm-1']
    y = target_data['intensity']
    
    # Identify range 980-1020 cm-1
    mask = (x >= 980) & (x <= 1020)
    x_sub = x[mask]
    y_sub = y[mask]
    
    # Find peak and midpoint
    idx_peak = np.argmax(y_sub)
    peak_val = y_sub[idx_peak]
    min_val = np.min(y_sub)
    threshold = (peak_val - min_val) / 2.0
    
    print(f"Peak value: {peak_val}")
    print(f"Minimum in range: {min_val}")
    print(f"Threshold for FWHM: {threshold}")
    
    # Identify crossing points using linear interpolation
    crossings = []
    for i in range(len(y_sub) - 1):
        x1, x2 = x_sub[i], x_sub[i+1]
        y1, y2 = y_sub[i], y_sub[i+1]
        if (y1 <= threshold <= y2 or y2 <= threshold <= y1) and y1 != y2:
            # Linear interpolation calculation
            x_cross = x1 + (threshold - y1) * (x2 - x1) / (y2 - y1)
            crossings.append(x_cross)
    
    print(f"Crossings found at: {crossings}")
    
    if len(crossings) >= 2:
        # Filter for the two crossings that flank peak_x[idx_peak]
        peak_x = x_sub[idx_peak]
        left_crossing = -1e9
        right_crossing = 1e9
        for c in crossings:
            if c <= peak_x:
                left_crossing = max(left_crossing, c)
            else:
                right_crossing = min(right_crossing, c)
        
        fwhm = right_crossing - left_crossing
        print(f"Calculated FWHM: {fwhm}")
    else:
        # If only one or no crossings are found, the shape might be flat or narrow
        if len(crossings) == 1:
            # Fallback if it's perfectly on a boundary or very sharp
            pass
        else:
            # Standard case should have at least two.
            pass
    , file_ids=['2026-08-10/T045.csv'])
