    run_analysis(code=import numpy as np
    import matplotlib.pyplot as plt
    
    # The spectra are available in the 'spectra' list provided by the system.
    # They were acquired at 20%, 40%, and 60% power respectively.
    # We identify them by their titles which contain "20%", "40%", and "60%".
    
    target_powers = [20, 40, 60]
    snr_values = []
    
    for p in target_powers:
        # Find the spectrum for this power
        match = None
        for s in spectra:
            if f"{p}%" in s['title']:
                match = s
                break
        
        if match:
            intensity = match['intensity']
            raman_shift = match['raman_shift'] # This is the x-axis (cm-1)
            
            # T050 definition: 
            # signal = max in range 990 to 1012
            # noise = std dev of intensity in range 1800 to 1900 (ddof=1)
            
            # Identify indices for the given ranges
            sig_mask = (raman_shift >= 990) & (raman_shift <= 1012)
            noise_mask = (raman_shift >= 1800) & (raman_shift <= 1900)
            
            # Filter intensities based on masks
            sig_data = intensity[sig_mask]
            noise_data = intensity[noise_mask]
            
            # Calculate SNR
            # Note: ensure data is not empty before calculation
            if len(sig_data) > 0 and len_no_zero_val := (np.std(noise_data, ddof=1) != 0):
                snr = np.max(sig_data) / np.std(noise_data, ddof=1)
            else:
                snr = 0.0 # Fallback if noise is constant or range is empty
                
            snr_values.append(float(snr))
            print(f"Power {p}% - Max Signal: {np.max(sig_data):.2f}, Noise Std: {np.std(noise_data, ddof=1):.4f}, SNR: {snr:.4f}")
    
    # Plotting
    plt.figure(figsize=(8, 6))
    plt.plot(target_powers, snr_values, marker='o', linestyle='-', color='b')
    plt.title('SNR vs Laser Power')
    plt.xlabel('Laser Power (%)')
    plt.ylabel('SNR (T050)')
    plt.xticks(target_powers)
    plt.grid(True, alpha=0.3)
    plt.savefig('snr_vs_power.png')
    
    # Output values for the final report
    print(f"Final SNR list: {snr_values}")
    )
