        if 'T046_sample.csv' in f['filename']:
            sample_raw = f['table']
    
    # Extract arrays
    x_ref = ref_raw['raman_shift_cm-1'].values
    y_ref = ref_raw['intensity'].values
    x_samp = sample_raw['raman_shift_cm-1'].values
    y_samp = sample_raw['intensity'].values
    
    # Peak detection on reference
    # Prominence at 5% of range. Range is 200 to 2000, so 1800 * 0.05 = 90.
    # However, it's better to calculate based on the actual max-min of the data if we want "of range".
    # Or just use 5% of (max - min) of the intensity values found in that specific spectrum?
    # The prompt says "prominence at 5% of range", usually meaning the Y-axis range.
    y_ref_range = np.ptp(y_ref)
    prom_ref = 0.05 * y_ref_range
    peaks_ref, _ = find_peaks(y_ref, prominence=prom_ref)
    # Or let's stick to a standard interpretation of "range" if not specified:
