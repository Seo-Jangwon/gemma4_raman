    import numpy as np
    from scipy import interpolate
    
    # Identify files
    t128_f = next(f for f in files if 'T128.csv' in f['filename'])
    ref_f = next(f for f in files if 'reference_library.csv' in f['filename'])
    
    # Reference axis: 200 to 2000 inclusive, step 1 (based on T128 and Ref lib stats)
    # Let's just use the unique values from reference_library as requested "onto the reference axis"
    ref_axis = np.sort(np.unique(ref_f['table']['raman_shift_cm-1']))
    
    # Process T128
    t128_x = t128_f['table']['raman_shift_cm-1']
    t128_y = t128_f['table']['intensity']
    f_t128 = interpolate.interp1d(t128_x, t128_y, bounds_error=False, fill_value="extrapolate")
    t128_interp = f_t128(ref_axis)
    
    # IPBSA order 5 and L2 Norm for T128
    t128_corrected, _ = ipbsa(t128_interp, order=5)
    norm_t128 = t128_corrected / np.linalg.norm(t128_corrected)
    
    # Reference Library processing
    ref_ids = ref_f['table']['spectrum_id']
    ref_mats = ref_f['table']['material']
    ref_x = ref_f['table']['raman_shift_cm-1']
    ref_y = ref_f['table']['intensity']
    
    unique_sids = np.unique(ref_ids)
    scores = []
    
    for sid in unique_sids:
        idx = np.where(ref_ids == sid)[0]
        sx = ref_x[idx]
        sy = ref_y[idx]
        
        if len(sx) != len(sy):
            print(f"Error: length mismatch for {sid}: x={len(sx)}, y={len(sy)}")
            continue
    
        # Interpolate onto reference axis
        f_s = interpolate.interp1d(sx, sy, bounds_error=False, fill_value="extrapolate")
        sy_interp = f_s(ref_axis)
        
        # IPBSA order 5 and L2 Norm
        sy_corrected, _ = ipbsa(sy_interp, order=5)
        norm_sy = sy_corrected / np.linalg.norm(sy_corrected)
        
        # Cosine Similarity
        sim = np.dot(norm_t128, norm_sy)
        mat = ref_mats[idx[0]]
        scores.append({'spectrum_id': sid, 'material': mat, 'similarity': sim})
    
    # Sort by similarity (desc), then spectrum_id (asc)
    scores.sort(key=lambda x: (-x['similarity'], x['spectrum_id']))
    
    best = scores[0]
    print(f"Winner: {best['spectrum_id']} | Material: {best['material']} | Sim: {best['similarity']:.6f}")
    for i in range(min(5, len(scores))):
        s = scores[i]
        print(f"{i+1}: {s['spectrum_id']} ({s['material']}) - {s['similarity']:.6f}")
    , file_ids=['2026-08-10/T128.csv', '2026-08-10/reference_library.csv'])
