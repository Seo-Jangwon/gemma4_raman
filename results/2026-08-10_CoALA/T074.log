    unique_locs_dict = {}
    for i, (x, y) in enumerate(zip(x_coords, y_coords)):
        if (x, y) not in unique_locs_dict:
            unique_locs_dict[(x, y)] = []
        unique_locs_dict[(x, y)].append(i)
    
    # Actually, the logic should be: 
