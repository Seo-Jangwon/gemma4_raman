    # 2. For each location, identify its specific Raman shifts and intensity values.
    # Since the file is a flat table of [x, y, shift, int], we need to isolate data for each unique (x,y).
    
    # Correct logic:
    loc_keys = list(set(zip(x_coords, y_coords)))
    num_unique = len(loc_keys)
    
    # We'll build a list of spectra. To compare them using cosine similarity, 
    # they must be aligned on the same Raman shifts.
    # First, find the set of unique Raman shifts present in the entire file.
    all_shifts = np.unique(raman_shift)
    # Note: some locations might not have all shifts or might have different ones.
    # But for this calculation, we'll assume they align on a common grid if possible.
    
    spectra_list = []
    for loc in loc_keys:
        mask = (x_coords == loc[0]) & (y_coords == loc[1])
        loc_ints = intensity[mask]
        # To ensure alignment, we need to map these intensities to the global 'all_shifts' array.
        # This handles cases where different locations might have slightly different recorded shifts or missing ones.
        temp_dict = {}
        for i, val in enumerate(loc_ints):
            temp_dict[raman_shift[mask][i]] = val
        
        # Create a vector for this location corresponding to all_shifts
        vec = np.array([temp_dict.get(s, 0) for s in all_shifts])
        spectra_list.append(vec)
    
    spectra_array = np.array(spectra_list) # Shape: (num_unique, len(all_shifts))
    
    # 1. Compute the element-wise median spectrum
    median_spectrum = np.median(spectra_array, axis=0)
    
    # 2. Calculate cosine similarity to the median (after L2 normalization)
    # Cosine similarity is (A . B) / (||A|| * ||B||). 
    # Since we just need the similarity of each row to a fixed vector:
    def norm_vec(v):
        return v / np.linalg.norm(v)
    
    norm_median = norm_vec(median_spectrum)
    norms = np.array([np.linalg.norm(s) for s in spectra_array])
    # Avoid division by zero if a spectrum is all zeros
