        data_dict['intensity'] = np.array(table['intensity'])
    
    if data_dict:
        x_coords = data_dict['x']
        y_coords = data_dict['y']
        raman_shifts = data_dict['raman_shift']
        intensities = data_dict['intensity']
    
        # 1. Identify unique locations
        # Combine x and y into a coordinate pair and find unique ones
        coords = np.vstack((x_coords, y_coords)).T
        unique_indices = np.unique(coords, axis=0, return_index=True)[1]
        unique_locs = coords[unique_indices]
        print(f"Total unique locations found: {len(unique_locs)}")
    
        # 2. Build spectra matrix
        # All indices in the original data correspond to some count of (x, y) but different raman shifts.
