        y_coords = np.array(found_data['y'])
        raman_shift = np.array(found_data['raman_shift_cm-1'])
        intensity = np.array(found_data['intensity'])
    
        # 1. Find unique coordinates
        unique_locs = []
        seen = set()
        for i in range(len(x_coords)):
            key = (float(x_coords[i]), float(y_coords[i]))
            if key not in seen:
                seen.add(key)
                unique_locs.append(key)
        
        print(f"Number of unique locations found: {len(unique_locs)}")
    
        # 2. Build spectrum matrix
        all_shifts = np.sort(np.unique(raman_shift))
        num_shifts = len(all_shifts)
        spectra_matrix = np.zeros((len(unique_locs), num_shifts))
        
        for i, loc in enumerate(unique_locs):
            mask = (x_coords == loc[0]) & (y_coords == loc[1])
            m_ints = intensity[mask]
            m_shifts = raman_shift[mask]
            # Map each shift to its index in the sorted list of all_shifts
            for s, val in zip(m_shifts, m_ints):
                idx = np.where(all_shifts == s)[0][0]
                spectra_matrix[i, idx] = val
    
        # 3. Determine median spectrum
        median_spectrum = np.median(spectra_matrix, axis=0)
    
        # 4. Calculate similarity (using L2 normalization for cosine similarity calculation)
        def get_cos_sim(v1, v2):
            n1 = np.linalg.norm(v1)
            n2 = np.linalg.norm(v2)
            if n1 == 0 or n2 == 0: return 1.0
            return np.dot(v1 / n1, v2 / n2)
    
        sims = [get_cos_sim(spectra_matrix[i], median_spectrum) for i in range(len(unique_locs))]
        
        # 5. Find anomalies (<0.80 similarity)
