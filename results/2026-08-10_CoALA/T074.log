    unique_locs = coords[unique_indices]
    print(f"Total unique locations found: {len(unique_locs)}")

    # 2. Build spectra matrix
    # All indices in the original data correspond to some count of (x, y) but different raman shifts.
    # We need one row per unique location and one column per distinct Raman shift.
    distinct_shifts = np.unique(raman_shifts)
    spectra_matrix = np.zeros((len(unique_locs), len(distinct_shifts)))

    for i, loc in enumerate(unique_locs):
        # Find indices in the original data that match this location
        mask = (x_coords == loc[0]) & (y_coords == loc[1])
        subset_intensities = intensities[mask]
        subset_shifts = raman_shifts[mask]
        
        for s, val in zip(subset_shifts, subset_intensities):
            # Find the index of this shift in the global distinct_shifts array
            shift_idx = np.where(distinct_shifts == s)[0][0]
            spectra_matrix[i, shift_idx] = val

