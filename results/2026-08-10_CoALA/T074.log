    num_locs = len(unique_locations)
    
    # Get indices of points belonging to each unique location
    indices = []
    for loc in unique_locations:
        mask = (x_coords == loc[0]) & (y_coords == loc[1])
        indices.append(np.where(mask)[0])
    
    # Extract spectra for each location
    # Each spectrum is a vector of intensities at the specific Raman shifts present in that location's group.
    # However, since all rows share the same set of raman_shifts (implicitly from the file structure),
