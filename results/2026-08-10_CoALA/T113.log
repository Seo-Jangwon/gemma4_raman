    run_analysis(code=import numpy as np
    
    # Load both files
    # T113.csv has [raman_shift, intensity]
    # reference_library.csv has [spectrum_id, material, raman_shift, intensity]
    
    t113 = None
    ref_lib = None
    
    # Using indices to access the data as per specifications
    # file_ids are passed in via run_analysis and accessible through 'files' dict.
    
    # Analysis logic:
    # 1. Load T113 spectra
    # 2. Load reference library
    # 3. Determine unique spectrum IDs in the reference library
    # 4. For each unique ID, extract its data.
    # 5. Interpolate T113 onto a common grid (or just use shared Raman shift values since both are from 200-2000)
    #    Actually, the prompt says "interpolate onto the reference axis". This implies we should find the union of axes or the set of unique x-values in ref_lib.
    # 6. Normalize T113 (L2 norm) and each reference spectrum (L2 norm).
    # 7. Compute cosine similarity: dot(A, B) / (norm(A) * norm(B)). Since they are L2 normalized, it's just the dot product of vectors.
    
    # Step 1: Identify unique IDs
    unique_ids = []
    if ref_lib is not None:
        # The 'files' structure for reference_library.csv:
        # files[file_id]['table'] has keys like 'spectrum_id', 'material', 'raman_shift_cm-1', 'intensity'.
        df_ref = ref_lib['table']
        unique_ids = df_ref['spectrum_id'].unique().tolist()
    
    # Step 2: Process T113
    if t113 is not None:
        t113_data = t113['table']
        x_t113 = t113_data['raman_shift_cm-1'].values
        y_t113 = t113_data['intensity'].values
    
    # Step 3: Process Reference Library and Calculate Similarity
    results = []
    for sid in unique_ids:
        subset = df_ref[df_ref['spectrum_id'] == sid]
        x_ref = subset['raman_shift_cm-1'].values
        y_ref = subset['intensity'].values
        material = subset['material'].iloc[0]
    
        # Interpolate T113 onto the x_ref axis
        # Note: Both have same range 200-2000 usually, but interpolation ensures alignment.
        y_t113_interp = np.interp(x_ref, x_t113, y_t113)
    
        # L2 Normalize T113 (the interpolated one or the original? 
        # "interpolate onto the reference axis, L2 normalize" usually implies 
        # interpolating first to align dimensions, then normalizing).
        y_t113_norm = y_t113_interp / np.linalg.norm(y_t113_interp)
        y_ref_norm = y_ref / np.linalg.norm(y_ref)
    
        # Cosine similarity of L2 normalized vectors is dot product
        score = np.dot(y_t113_norm, y_ref_norm)
        results.append({
            "id": sid,
            "material": material,
            "score": score
        })
    
    # Sort by score descending
    results.sort(key=lambda x: x['score'], reverse=True)
    
    # Output top 3
    top_3 = results[:3]
    print(f"Top 3 matches: {top_3}")
    , file_ids=['2026-08-10/T113.csv', '2026-08-10/reference_library.csv'])
