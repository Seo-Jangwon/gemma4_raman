    run_analysis(code=import numpy as np
    
    # Load the files
    target_file = "2026-08-10/T113.csv"
    ref_file = "2026-08-10/reference_library.csv"
    
    # Access data from file_ids
    t113_data = files[0]["table"] # T113.csv is at index 0 (based on inspection)
    ref_lib_data = files[1]["table"] # reference_library.csv is at index 1
    
    # Extract T113 spectrum
    x_t113 = t113_data["raman_shift_cm-1"].values
    y_t113 = t113_data["intensity"].values
    
    # Filter out negative intensities or noise if necessary (the prompt doesn't specify, but we should ensure clean input)
    mask_t113 = y_t113 > 0
    x_t113 = x_t113[mask_t113]
    y_t113 = y_t113[mask_t113]
    
    # Get unique reference spectrum metadata and data
    # The file has: spectrum_id, material, raman_shift_cm-1, intensity
    # We need to identify unique spectra by spectrum_id.
    unique_ids = np.unique(ref_lib_data["spectrum_id"].values)
    
    results = []
    
    for sid in unique_ids:
        mask = ref_lib_data["spectrum_id"] == sid
        x_ref = ref_lib_data["raman_shift_cm-1"].values[mask]
        y_ref = ref_lib_data["intensity"].values[mask]
        mat = ref_lib_data["material"].values[mask][0]
        
        # Interpolate target spectrum onto the reference axis if they don't match exactly
        # But here both are likely on a 1.0 cm-1 grid (200 to 2000).
        # Let most robust: interpolate BOTH onto a common dense grid or just map T113 to Ref.
        # Since the request says "interpolate onto the reference axis":
        y_t113_interp = np.interp(x_ref, x_t113, y_t113)
        
        # L2 Normalize both (or just one since we are calculating cosine similarity)
        # Cosine similarity: (A . B) / (||A|| * ||B||)
        # To do this correctly after interpolation, we use the interpolated T113.
        norm_t = np.sqrt(np.sum(y_t113_interp**2))
        norm_r = np.sqrt(np.sum(y_ref**2))
        
        if norm_t > 0 and norm_r > 0:
            score = np.dot(y_t113_interp, y_ref) / (norm_t * norm_r)
        else:
            score = 0.0
            
        results.append({
            "id": sid,
            "material": mat,
            "score": float(score)
        })
    
    # Sort by score descending
    results.sort(key=lambda x: x["score"], reverse=True)
    
    # Print the top 3 results for the final report
    top_3 = results[:3]
    print(f"Top 3 matches: {top_3}")
    , file_ids=['2026-08-10/T113.csv', '2026-08-10/reference_library.csv'])
