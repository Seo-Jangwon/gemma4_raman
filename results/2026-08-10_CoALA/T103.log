    run_analysis(code=import numpy as np
    from scipy import signal
    
    # Data is provided in the 'files' variable via file_ids parameter.
    # The request says T103.csv are all shifted by same amount from T103_ref.csv
    # We need to estimate shift using cross-correlation and correct it.
    
    y1 = files[0]['table']['intensity'].values
    x1 = files[0]['table']['raman_shift_cm-1'].values
    y2 = files[1]['table']['intensity'].values
    x2 = files[1]['table']['raman_shift_cm-1'].values
    
    # Use scipy.signal.correlate to find the shift. 
    # Since x1 and x2 are both linearly spaced with step=1, 
    # the peak of cross-correlation gives us the index offset directly.
    
    # Standard convolution/correlation:
    # correlation(y1, y2) = sum_j y1[i] * y2[i-k]
    # If we want to find k such that y1 is shifted by k from y2... 
    # Actually, let's use a more robust way to find the peak.
    
    corr = signal.correlate(y1, y2, mode='full')
    # The middle index of 'full' correlation for equal length arrays is len(y2)-1.
    peak_idx = np.argmax(corr)
    shift = peak_idx - (len(y2) - 1)
    
    print(f"Detected shift: {shift}")
    
    # Now identify peaks in the original data and adjust them.
    # A standard find_peaks or just looking at significant ones.
    # The task asks for "corrected peak positions".
    # If y1 is shifted by 'shift' relative to y2, 
    # it means a feature at x_ref becomes visible at x_ref + shift in the raw data?
    # No, usually "shifted" implies the labels (x-axis) are misaligned.
    # If peaks of T103 are shifted FROM reference, then:
    # Observed Position = Reference Position + Shift_Value
    # Therefore: Corrected Peak position (on the original x-axis) is just what it is? 
    # No, "correct it" means if we found that the peak at say 1500 was actually meant to be at 1490.
    # The difference is 'shift'.
    
    # Let's calculate the shift and then subtract it from the measured positions 
    # to align them with the reference.
    
    peak_indices = np.where(y1 > np.mean(y1) + 2*np.std(y1))[0] # Basic threshold for peaks
    raw_peaks = x1[peak_indices]
    corrected_peaks = raw_peaks - shift
    
    print(f"Raw peak positions: {raw_peaks}")
    print(f"Corrected peak positions: {corrected_peaks}")
    
    # Output for the user
    # We report the first few peaks as corrected.
    , file_ids=['2026-08-10/T103.csv', '2026-08-10/T103_ref.csv'])
