    raw_peak_pos = x1[peaks_idx]
    corrected_peak_pos = raw_peak_pos - shift
    
    print(f"Raw Peak Positions: {raw_peak_pos}")
    print(f"Corrected Peak Positions: {corrected_peak_pos}")
