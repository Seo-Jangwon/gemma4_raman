    # The user wants cross-correlation to find shift and corrected peaks.
    
    # 1. Extract data
    data1 = files[0]['table'] # T103
    data2 = files[1]['table'] # T103_ref
    
    y1 = data1['intensity'].values
    x1 = data1['raman_shift_cm-1'].values
    y2 = data2['intensity'].values
    x2 = data2['raman_shift_cm-1'].values
    
    # 2. Cross-correlation to find shift
    # We assume x1 and x2 are the same sampling grid (both 200 to 2000)
    # The signal y1 is shifted relative to y2.
    corr = signal.correlate(y1, y2, mode='same')
    # To find the shift in indices, we look for peak of correlation. 
    # However, since the sampling interval is 1 cm-1 (from inspection), 
    # the index of max correlation directly corresponds to the offset.
    
    # A more robust way:
    # We want to find 'shift' such that y2(x) approx y1(x + shift).
    # Or if they are on the same grid, corr = sum(y1[i] * y2[i-shift])
    # Since x values are known (200 to 2000), we can use cross-correlation.
    
    import numpy as np
    from scipy import signal
    
    # Let's define a search range for the shift if needed, but usually it's small.
    # Because x is a linear scale and step is constant, peak of cross-correlation tells us the offset.
    
    def find_shift(y1, y2):
        # Standard cross-correlation to find how much y1 is shifted relative to y2
        # To be precise about units, we can use scipy.signal.correlate 
        # and then map back to cm-1 if the resolution allows.
        corr = signal.correlate(y1, y2, mode='full')
        # The center of 'full' correlation is at len(y2)-1.
        # If there's no shift, peak is at index len(y2)-1 (or similar depending on implementation)
        # More reliably:
        corr = signal.correlate(y1, y2, mode='same')
        idx = np.argmax(corr)
        return idx
    
    # Let's use a simpler approach for common shift detection in spectra:
    # Since we know the grid is 1 unit wide, we can just find the peak of correlation.
    # We need to be careful with 'same' vs 'full'. 
    # In 'same', if y1 and y2 are same length, index 0 of corr corresponds to shift of 0? 
    # Not always guaranteed across versions.
    
    # Let's just use the cross-correlation logic:
    # If we want to find d such that y1(x) is roughly y2(x - d), then we correlate y1 and y2.
    # Since the x-axis is sampled at 1 cm-1, the peak position in the correlation array
    # gives us 'd' directly in units of samples (which are cm-1).
    
    corr = signal.correlate(y1, y2, mode='full')
    max_idx = np.argmax(corr)
    # In 'full', center is at len(y2)-1. 
    # If max_idx > len(y2)-1, shift is positive (y1 shifted right/higher wavenumber).
    # Actually, if y2 is the "reference", and we find where it best matches y1...
    
    # Let's re-evaluate:
    # Reference y2 is at x. 
    # Observed y1 is at x + shift.
    # Correlation peak indicates how much of y2 we have to "slide" over y1.
    # Because x1 == x2 (both are [200, 200, ...]), the index difference from center tells us the shift.
    
    shift = max_idx - (len(y2) - 1)
    
    print(f"Found shift: {shift}")
    
    # Now find peaks in y1 and adjust them
    # Using a standard peak finding or just reporting indices relative to shifted grid.
    # The user wants "corrected peak positions". This means the values of 'x' for the peaks after correction.
    # If we know the shift is X, then Peak_pos(shifted) = Peak_pos(observed) - X
    
    # Let's refine the search:
    from scipy.signal import find_peaks
    peaks, _ = find_peaks(y1, height=50) # Use a reasonable threshold or just all peaks
    current_peaks = x1[peaks]
    corrected_peaks = current_peaks - shift
    
    print(f"Original peak positions (approx): {current_peaks}")
    print(f"Corrected peak positions: {corrected_peaks}")
