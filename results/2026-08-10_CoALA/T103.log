    x1 = files[0]['table']['raman_shift_cm-1']
    y2 = files[1]['table']['intensity']
    x2 = files[1]['table']['raman_shift_cm-1']
    
    # Cross-correlation to find shift.
    # Because the arrays are same length and x is linear with unit step, 
    # the peak of 'full' correlation gives us the index offset.
    corr = signal.correlate(y1, y2, mode='full')
    peak_idx = np.argmax(corr)
    # In full mode, index (len(y2)-1) corresponds to zero shift.
    shift = peak_idx - (len(y2) - 1)
    
