    # for "shape" matching, but since T119 was already normalized, any high correlation
    # will stand out.
    
    # Note: if ref_data's intensity is zero or flat, standard deviation will be 0.
    if np.std(y_ref) > 0:
        correlation = np.corrcoef(y_norm, y_ref)[0, 1]
        if correlation > max_score:
            max_score = correlation
            best_material = mat

print(f"Best Match: {best_material} (Score: {max_score})")
