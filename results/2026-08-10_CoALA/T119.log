    # Define identification logic
    def find_best_material():
        t119 = None
        ref_lib = None
        for f in files:
            if "T119" in f['filename']: t119 = f
            elif "reference_library" in f['filename']: ref_lib = f
        
        # Process T119
        y_raw = t119['table']['intensity']
        x_raw = t119['table']['raman_shift_cm-1']
        y_smooth = savgol_filter(y_raw, 11, 3)
        
        # Reference Data
