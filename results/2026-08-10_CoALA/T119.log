    ```python
    import numpy as np
    from scipy.signal import savgol_filter
    
    # Load data from the provided files
    t119_data = None
    ref_lib_data = None
    
    for f in files:
        if "T119" in f['filename']:
            t119_data = f['table']
        elif "reference_library" in f['filename']:
            ref_lib_data = f['table']
    
    # Extract variables
    y_raw = t119_data['intensity']
    x_raw = t119_data['raman_shift_cm-1']
    
    # 1. Savitzky-Golay Smoothing (window_length=11, polyorder=3)
    y_smooth = savgol_filter(y_raw, 11, 3)
    
    # 2. Identify reference axis and interpolate
    x_ref_raw = ref_lib_data['raman_shift_cm-1']
    x_ref_unique = np.unique(x_ref_raw)
    y_interp = np.interp(x_ref_unique, x_raw, y_smooth)
    
    # 3. L2 Normalization (normalize vector to length 1)
    y_norm = y_interp / np.linalg.norm(y_interp)
    
    # 4. Match against reference library
    best_material = "unknown"
    max_score = -float('inf')
    
    for i in range(len(ref_lib_data['material'])):
        mat_name = ref_lib_data['material'][i]
        if not mat_name: continue
        
        y_ref = ref_lib_data['intensity'][i]
        # Use Pearson correlation to find the best match for shape.
        # Since y_norm is already L2-normalized, any large peak structure 
        # will correspond to a high correlation if it matches well.
        if np.std(y_ref) > 0:
            # Calculate correlation
            corr = np.corrcoef(y_norm, y_ref)[0, 1]
            if corr > max_score:
                max_score = corr
                best_material = mat_name
    
    print(f"Identified Material: {best_material}")
    print(f"Maximum Correlation Score: {max_score}")
    ```
    
