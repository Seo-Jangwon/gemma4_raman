```python
import numpy as np
from scipy.signal import savgol_filter

# Define identification logic
def find_best_material():
    t119 = None
    ref_lib = None
    for f in files:
        if "T119" in f['filename']: t119 = f
        elif "reference_library" in f['filename']: ref_lib = f
    
    # Process T119
    y_raw = t119['table']['intensity']
    x_raw = t119['table']['raman_shift_cm-1']
    y_smooth = savgol_filter(y_raw, 11, 3)
    
    # Reference Data
    ref_data = ref_lib['table']
    x_ref_unique = np.unique(ref_data['raman_shift_cm-1'])
    
    # Interpolation and Normalization
    y_interp = np.interp(x_ref_unique, x_raw, y_smooth)
    y_norm = y_interp / np.linalg.norm(y_interp)
    
    best_mat = "unknown"
    max_score = -1e6
    
    for i in range(len(ref_data['material'])):
        mat_name = ref_data['material'][i]
        if not mat_name: continue
        
        y_ref = ref_data['intensity'][i]
        # Correlation check
        # We want a high correlation for the best match. 
        # Since y_norm is L2 normalized, we don't strictly need to normalize y_ref 
        # unless it's very different in scale/offset (but we have no offset info).
        # Actually, since T119 was "low-signal", its peaks were probably small. 
        # Normalization is key here.
        
        if np.std(y_ref) > 0:
            # Use correlation coefficient
            corr = np.corrcoef(y_norm, y_ref)[0,1]
            if corr > max_score:
                max_score = corr
                best_mat = mat_name
    
    return best_mat, max_score

result, score = find_best_material()
print(f"Result: {result}, Score: {score}")
```

