    run_analysis(code=import numpy as np
    from sklearn.metrics.pairwise import cosine_similarity
    
    # Load both dataframes
    t114 = files['2026-08-10/T114.csv']['table']
    ref_lib = files['2026-08-10/reference_library.csv']['table']
    
    # Define x and y for T114
    t114_x = t114['raman_shift_cm-1'].values
    t114_y = t114['intensity'].values
    
    # Identify unique x values in the reference library to use as the target axis
    ref_x_all = ref_lib['raman_shift_cm-1'].values
    unique_ref_x = np.unique(ref_x_all)
    
    # Interpolate T114 onto the reference axis
    # Using a standard linear interpolation. 
    # Note: we ensure only non-negative intensities are kept for cosine similarity logic if necessary, 
    # but usually raw signals in these files represent physical measurements.
    t114_interp = np.interp(unique_ref_x, t114_x, t114_y)
    
    # Normalize the interpolated T114 vector for cosine similarity calculation
    # Since we need to find max similarity across many spectra in the library
    t114_norm = t114_interp / np.linalg.norm(t114_interp)
    
    best_score = 0.0
    
    # Group by spectrum_id to evaluate each unique reference entry
    unique_ids = ref_lib['spectrum_id'].unique()
    
    for sid in unique_ids:
        mask = ref_lib['spectrum_id'] == sid
        current_ref_y = ref_lib[mask]['intensity'].values
        
        # Ensure the lengths match (they should since we used unique_ref_x)
        if len(current_ref_y) == len(t114_interp):
            ref_norm = current_ref_y / np.linalg.norm(current_ref_y)
            # Cosine similarity of two normalized vectors is just the dot product
            score = np.dot(t114_norm, ref_norm)
            if score > best_score:
                best_score = score
    
    print(f"Best cosine similarity found: {best_score}")
    , file_ids=['2026-08-10/T114.csv', '2026-08-10/reference_library.csv'])
