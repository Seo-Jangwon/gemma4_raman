        current_ref_y = ref_lib[mask]['intensity'].values
        
        # Standard dot product of normalized vectors gives cosine similarity
        norm_val_ref = np.linalg.norm(current_ref_y)
        if norm_val_ref != 0:
            ref_norm = current_ref_y / norm_val_ref
            score = np.dot(t114_norm, ref_norm)
