    # Extract T114 values
    t114_x = t114_table['raman_shift_cm-1'].values
    t114_y = t114_table['intensity'].values
    
    # Determine the shared axis from the reference library
    ref_x_raw = ref_lib_table['raman_shift_cm-1'].values
    unique_ref_x = np.unique(ref_x_raw)
    
    # Interpolate T114 onto that specific x-axis
    t114_interp = np.interp(unique_ref_x, t114_x, t114_y)
    
    # Calculate L2 norm for T114 (the target)
    norm_t114 = np.linalg.norm(t114_interp)
    if norm_t114 != 0:
        t114_normed = t114_interp / norm_t114
