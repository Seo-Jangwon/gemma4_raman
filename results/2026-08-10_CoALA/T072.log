        target_spectra = [s for s in spectra if s.get('intensity') is not None]
    
    print(f"Processing {len(target_spectra)} spectra.")
    
    processed_matrix = []
    for i, s in enumerate(target_spectra):
        y = s['intensity']
        # Apply IPBSA order 5 (using the injected ipbsa function)
        corrected, _ = ipbsa(y, order=5)
        
        # L2 Normalization
        norm_val = np.linalg.norm(corrected)
        if norm_val > 0:
            norm_y = corrected / norm_val
        else:
            norm_y = corrected
        processed_matrix.append(norm_y)
    
    if len(processed_matrix) == 0:
        print("No data to process.")
    else:
        # Matrix is (N, M) where N=samples, M=features
        X = np.array(processed_matrix)
        # Mean-center the matrix along axis 1 (the features)
        # Wait, standard PCA centers across samples for each feature.
        # The mean of all rows for each column is subtracted.
        mean_vec = np.mean(X, axis=0)
        centered_matrix = X - mean_vec
        
        # Manual PCA using Eigh (since sklearn is not allowed)
        # 1. Covariance matrix C = (1/N-1) * X^T * X
        n_samples = centered_matrix.shape[0]
        if n_samples > 1:
            cov_matrix = np.dot(centered_matrix.T, centered_matrix) / (n_samples - 1)
        else:
            cov_matrix = np.dot(centered_matrix.T, centered_matrix)
            
        # 2. Eigh returns eigenvalues and eigenvectors
        eigenvalues, eigenvectors = np.linalg.eigh(cov_matrix)
        
        # Sort in descending order (eigh usually gives ascending for symmetric matrices)
        idx = np.argsort(eigenvalues)[::-1]
        sorted_eigenvalues = eigenvalues[idx]
        
        # Calculate variance ratio
        total_variance = np.sum(sorted_eigenvalues)
        if total_variance > 0:
            ratios = sorted_eigenvalues / total_variance
        else:
            ratios = [0, 0, 0]
        
        # Take first 3 components
        top_3_ratios = ratio_results = []
        for i in range(min(3, len(ratios))):
            top_3_ratios.append(float(ratios[i]))
        while len(top_3_ratios) < 3:
            top_3_ratios.append(0.0)
    
        print("Variance Ratios:", top_3_ratios)
    )
