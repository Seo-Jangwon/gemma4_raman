    # Step 1: Spike Removal
    def remove_spikes(y, window=5, factor=100):
        # Median filter for initial baseline/smoothing
        m = medfilt(y, kernel_size=window)
        # MAD (Median Absolute Deviation) to identify outliers
        # Note: Since we use the median filter already, we'll compute 
        # the deviation of the raw signal from the filtered one or just on the signal.
        # Standard approach for spikes in Raman is checking if value > mean + k*sigma
        # Given specific instructions "5-point moving median, 100x MAD":
        # We interpret this as identifying values that are more than 100*MAD from 
        # the local median to zero them out or replace them.
        
        # Let's do it properly:
        moving_med = medfilt(y, kernel_size=window)
        # Simple MAD calculation (rolling window would be better but simpler is often safer)
        # Actually, for a global "100x MAD" check against the median filter:
        mad = np.median(np.abs(y - moving_med)) 
        # If we want to strictly follow "5-point median", we calculate per point or use the array.
        # The prompt implies a standard spike rejection algorithm.
        denoised = y.copy()
        for i in range(len(y)):
            if abs(y[i] - moving_med[i]) > (100 * mad): # This is an extremely conservative threshold.
                denoised[i] = moving_med[i]
        return denoised
    
    # To be safe with the specific logic "5-point moving median, 100x MAD":
    # We'll assume standard calculation of MAD from the raw signal or the filtered one.
    m_5 = medfilt(raw_data, kernel_size=5)
    mad_val = np.median(np.abs(raw_data - m_5))
    spike_removed = np.array([y if abs(y - m_5[i]) < 100 * mad_val else m_5[i] for i, y in enumerate(raw_data)])
    
    # Step 2: IPBSA Baseline Order 5
    # We use the built-in ipbsa function.
    from utils import ipbsa # This is standard in the environment
    baseline_corrected = ipbsa(spike_removed, order=5)[0]
    
    # Step 3: Savitzky-Golay (11, 3)
    # window_length must be odd.
    sg_smoothed = savgol_filter(baseline_corrected, window_length=11, polyorder=3)
    
    # Step 4: 0-1 Normalization
    norm_min = sg_smoothed.min()
    norm_max = sg_smoothed.max()
    normalized = (sg_smoothed - norm_min) / (norm_max - norm_min)
    
    # Save the result
    save_result("processed_spectrum.csv", normalized, raman_shift=raman_shift)
    
    print(f"Processing complete.")
    print(f"Original Max: {np.max(raw_data)}")
    print(f"Baseline Corrected Max: {np.max(baseline_corrected)}")
    print(f"Normalized Max: {np.max(normalized)}")
    print(f"Peaks found at indices: {np.argsort(normalized)[-3]}")
