        "code": "import numpy as np\n\npeak_pos = 1001\nintensities = []\n\nfor s in spectra:\n    # Find index of the value closest to peak_pos in raman_shift\n    idx = (np.abs(s['raman_shift'] - peak_pos)).argmin()\n    val = s['intensity'][idx]\n    intensities.append(val)\n\nmean_val = np.mean(intensities)\nstd_val = np.std(intensities, ddof=1)\nrsd_pct = (std_val / mean_val) * 100\n\nprint(f\"Peak Position: {peak_pos} cm-1\")\nprint(f\"Intensities: {intensities}\")\nprint(f\"Mean: {mean_val}\")\nprint(f\"Std Dev: {std_val}\")\nprint(f\"RSD (%): {rsd_pct}\")"
