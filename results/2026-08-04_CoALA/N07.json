        "code": "# The user wants a plot of total intensity over the kinetic series.\n# Let's check the existing file first to see its content and parameters.\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# The spectra list contains measurements from this session.\nfor s in spectra:\n    if '205311_188' in s['base']:\n        frames = s['frames']\n        print(f\"Found kinetic measurement {s['base']}\")\n        print(f\"Shape: {frames.shape}\") # (n_frames, n_pixels)\n        print(f\"Max intensity: {np.max(frames)}\")\n        print(f\"Power: {s['power']}, Exposure: {s['exposure']}\")\n        \n        # Calculate sum per frame\n        frame_sums = np.sum(frames, axis=1)\n        print(f\"Frame sums: {frame_sums}\")\n        \n        plt.figure()\n        plt.plot(range(len(frame_sums)), frame_sums, marker='o')\n        plt.xlabel('Frame Index')\n        plt.ylabel('Total Intensity')\n        plt.title(f'Intensity over time for {s[\"base\"]}')\n        plt.grid(True)\n        plt.show()\n        \n        # Save result just in case we need the numbers later, though print is fine here\n        save_result('kinetic_sums', frame_sums)\n",
