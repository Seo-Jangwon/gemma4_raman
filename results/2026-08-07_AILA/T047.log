    I'll write the code now. I need to make sure IPBSA is implemented correctly as a function.
    
    ```python
    import numpy as np
    from scipy import signal as sp_signal
    from scipy.interpolate import interp1d
    
    def remove_spikes(x, y, window=5, threshold_factor=5):
        # Moving median filter
        median_y = np.zeros_like(y)
        half = window // 2
        for i in range(len(y)):
            start = max(0, i - half)
            end = min(len(y), i + half + 1)
            median_y[i] = np.median(y[start:end])
        
        # Calculate residuals and MAD
        residuals = y - median_y
        mad = np.median(np.abs(residuals - np.median(residuals)))
        
        # Identify spikes
        spikes = np.abs(residuals) > threshold_factor * mad
        num_spikes = np.sum(spikes)
        
        # Linear interpolation for spikes
        y_clean = y.copy()
        x_indices = np.arange(len(y))
        valid_indices = x_indices[~spikes]
        interp_func = interp1d(valid_indices, y[~spikes], kind='linear', fill_value="extrapolate")
        y_clean[spikes] = interp_func(x_indices[spikes])
        
        return y_clean, num_spikes
    
    def ipbsa_baseline(x, y, order=5, max_iter=100, tol=1e-4):
        # Initialize baseline as a polynomial fit to all data
        coeffs = np.polyfit(x, y, order)
        baseline = np.polyval(coeffs, x)
        
        for i in range(max_iter):
            # Find points where signal >= baseline
            mask = y >= baseline
            if np.sum(mask) <= order + 1: # Not enough points to fit
                break
                
            new_coeffs = np.polyfit(x[mask], y[mask], order)
            new_baseline = np.polyval(new_coeffs, x)
            
            # Check convergence
            if np.linalg.norm(new_coeffs - coeffs) < tol:
                baseline = new_baseline
                break
            
            coeffs = new_coeffs
            baseline = new_baseline
            
        return baseline
    
    def process_spectrum(x, y):
        # 1. Spike Removal
        y_despiked, n_spikes = remove_spikes(x, y)
        
        # 2. IPBSA Baseline Correction
        baseline = ipbsa_baseline(x, y_despiked, order=5)
        y_baseline_corrected = y_despiked - baseline
        
        # 3. Savitzky-Golay Smoothing (11, 3)
        y_smoothed = sp_signal.savgol_filter(y_baseline_corrected, 11, 3)
        
        # 4. Normalization (0-1)
        y_min = np.min(y_smoothed)
        y_max = np.max(y_smoothed)
        y_final = (y_smoothed - y_min) / (y_max - y_min)
        
        return y_final, n_spikes
    
    # Inside run_analysis:
    # x = files[0]["table"]["raman_shift_cm-1"]
    # y = files[0]["table"]["intensity"]
    # ... call process_spectrum ...
    # save_result('T047_processed', y_final, raman_shift=x)
