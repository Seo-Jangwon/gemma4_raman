    {
      "name": "run_analysis",
      "args": {
        "code": "import numpy as np\nfrom scipy.interpolate import interp1d\n\n# 1. Load reference spectrum from attached files\nref_id = '2026-08-07/T071_ref.csv'\nref_x = files[0]['table']['raman_shift_cm-1']\nref_y = files[0]['table']['intensity']\n\ndef get_similarity(s1, s2):\n    # Normalize both to common axis (interpolating s1 onto s2)\n    f = interp1d(s1['raman_shift'], s1['intensity'], bounds_error=False, fill_value=0)\n    y1_interp = f(ref_x)\n    y2 = ref_y\n    \n    # L2 Distance\n    l2 = np.linalg.norm(y1_interp - y2)\n    \n    # Cosine Similarity\n    cos = np.dot(y1_interp, y2) / (np.linalg.norm(y1_interp) * np.linalg.norm(y2))\n    \n    return l2, cos\n\nresults = []\nfor s in spectra:\n    l2, cos = get_similarity(s, ref_y)\n    results.append({'x': s['x'], 'l2': l2, 'cos': cos})\n\n# Sort by x to ensure they are sequential\nresults.sort(key=lambda val: val['x'])\n\n# Compute changes between adjacent positions\nl2_diffs = np.abs(np.diff([r['l2'] for r in results]))\ncos_diffs = np.abs(np.diff([r['cos'] for r in results]))\n\nmax_l2_idx = np.argmax(l2_diffs)\nmax_cos_idx = np.argmax(cos_diffs)\n\nprint(f\"L2 differences: {l2_diffs}\")\nprint(f\"Cosine differences: {cos_diffs}\")\nprint(f\"Max L2 change at index: {max_l2_idx} (between {results[max_l2_idx]['x']} and {results[max_l2_idx+1]['x']})\")\nprint(f\"Max Cosine change at index: {max_cos_idx} (between {results[max_cos_idx]['x']} and {results[max_cos_idx+1]['x']})\")\n\n# The boundary_index is the 0-based index of the point where the change occurs.\n# Usually, the \"boundary position\" refers to the first of the two points forming the largest jump.\n",
        "file_ids": [
          "2026-08-07/T071_ref.csv"
        ]
      },
      "ok": true
    }
