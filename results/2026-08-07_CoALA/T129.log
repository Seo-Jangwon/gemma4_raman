    run_analysis(code=import numpy as np
    from scipy import signal
    import matplotlib.pyplot as plt
    
    # Load data
    t129_data = None
    ref_data = None
    for f in files:
        if 'T129.csv' in f['filename']:
            t129_data = f['table']
        elif 'reference_library.csv' in f['filename']:
            ref_data = f['table']
    
    # Ensure 1D arrays
    s_x = t129_data["raman_shift_cm-1"].flatten()
    s_y = t129_data["intensity"].flatten()
    
    r_ids = ref_data["spectrum_id"].flatten()
    r_mats = ref_data["material"].flatten()
    r_x = ref_data["raman_shift_cm-1"].flatten()
    r_y = ref_data["intensity"].flatten()
    
    unique_spectra = np.unique(r_ids)
    results = []
    
    # Pre-process sample: Z-score normalization
    s_y_norm = (s_y - np.mean(s_y)) / np.std(s_y)
    
    for sid in unique_spectra:
        mask = (r_ids == sid)
        mat = r_mats[mask][0]
        cur_x = r_x[mask]
        cur_y = r_y[mask].flatten() # Ensure 1D
        
        # Reference spectra might have different lengths or sampling. 
        # Based on inspect_file, both are 200-2000 with 1 cm-1 steps (1801 points).
        # Let's verify the length of the reference slice first.
        if len(cur_y) != len(s_y):
            continue # Skip if lengths differ for correlate
    
        ry_norm = (cur_y - np.mean(cur_y)) / np.std(cur_y)
        
        # Cross-correlation
        corr = signal.correlate(s_y_norm, ry_norm, mode='full')
        lags = signal.correlation_lags(len(s_y_norm), len(ry_norm), mode='full')
        
        best_lag = lags[np.argmax(corr)]
        max_corr = np.max(corr)
        
        results.append({
            'id': sid, 
            'material': mat, 
            'shift': best_lag, 
            'correlation': max_corr
        })
    
    # Find the material with highest correlation
    best_match_info = max(results, key=lambda x: x['correlation'])
    mat_name = best_match_info['material']
    est_shift = best_match_info['shift']
    
    print(f"Best match: {mat_name}")
    print(f"Estimated shift: {est_shift} cm-1")
    
    # Verification Plot
    mask = (r_ids == best_match_info['id'])
    ref_y = r_y[mask]
    ref_x = r_x[mask]
    
    plt.figure(figsize=(10, 5))
    plt.plot(s_x, s_y, label='Sample (T129)', alpha=0.7)
    # Shift the reference by the estimated amount to see if it aligns with sample
    plt.plot(ref_x + est_shift, ref_y, label=f'Ref {mat_name} (shifted +{est_shift})', alpha=0.7)
    plt.title(f"Verification: Sample vs Shifted Reference ({mat_name})")
    plt.xlabel("Raman shift (cm-1)")
    plt.ylabel("Intensity")
    plt.legend()
    plt.savefig('verification_shift.png')
    
    # Numerical verification: check if peak positions align after shift
    # Find top 3 peaks in both
    from scipy.signal import find_peaks
    s_peaks, _ = find_peaks(s_y - np.mean(s_y), height=10)
    r_peaks, _ = find_peaks(ref_y - np.mean(ref_y), height=10)
    
    if len(s_peaks) > 0 and len(r_peaks) > 0:
        # Compare the highest peak
        s_peak_val = s_x[s_peaks[np.argmax(s_y[s_peaks])]]
        r_peak_val = ref_x[r_peaks[np.argmax(ref_y[r_peaks])]]
        actual_diff = s_peak_val - r_peak_val
        print(f"Highest peak sample: {s_peak_val}, Highest peak ref: {r_peak_val}")
        print(f"Difference between highest peaks: {actual_diff} cm-1")
    , file_ids=['2026-08-07/T129.csv', '2026-08-07/reference_library.csv'])
