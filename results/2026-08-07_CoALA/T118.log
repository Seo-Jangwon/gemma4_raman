    import numpy as np
    import matplotlib.pyplot as plt
    
    ref_df = files[0]['table']
    mix_df = files[1]['table']
    
    # Strip whitespace and check counts
    mats = np.array([str(m).strip() for m in ref_df['material']])
    shifts = ref_df['raman_shift_cm-1']
    intensities = ref_df['intensity']
    
    unique_mats = np.unique(mats)
    print(f"Cleaned unique materials: {unique_mats}")
    
    # Count occurrences per material to see the sizes
    for m in unique_mats:
        count = np.sum(mats == m)
        print(f"{m}: {count} points")
    
    def get_spectrum_robust(mat_name):
        mask = (mats == mat_name)
        if not np.any(mask):
            return None, None
        # If multiple spectra exist for one material, we take the first one's length 
        # or just average them? Let's see if they are consistent.
        # Actually, let's just get all intensities for this material and group by spectrum_id
        ids = ref_df['spectrum_id']
        unique_ids_for_mat = np.unique(ids[mask])
        print(f"IDs for {mat_name}: {unique_ids_for_mat}")
        
        # Take the first ID's spectrum
        target_id = unique_ids_for_mat[0]
        final_mask = (ids == target_id)
        return shifts[final_mask], intensities[final_mask]
    
    x_ps, y_ps = get_spectrum_robust('polystyrene')
    x_pmma, y_pmma = get_spectrum_robust('PMMA')
    
    x_mix = mix_df['raman_shift_cm-1']
    y_mix = mix_df['intensity']
    
    if x_ps is not None and x_pmma is not None:
        print(f"Lengths - PS: {len(y_ps)}, PMMA: {len(y_pmma)}, Mix: {len(y_mix)}")
        
        # Pearson Correlation
        def get_corr(y1, y2):
            if len(y1) != len(y2): return None
            return np.corrcoef(y1, y2)[0, 1]
    
        c_ps = get_corr(y_mix, y_ps)
        c_pmma = get_corr(y_mix, y_pmma)
        print(f"Corr PS: {c_ps}")
        print(f"Corr PMMA: {c_pmma}")
    
        # Plotting
        plt.figure(figsize=(10, 6))
        def norm(y): return (y - np.min(y)) / (np.max(y) - np.min(y))
        plt.plot(x_mix, norm(y_mix), label='T118', color='k', lw=2)
        plt.plot(x_ps, norm(y_ps), label='Polystyrene', linestyle='--', alpha=0.7)
        plt.plot(x_pmma, norm(y_pmma), label='PMMA', linestyle=':', alpha=0.7)
        plt.legend()
        plt.title('Comparison')
        plt.savefig('comparison_final.png')
    else:
        print("Still could not find spectra.")
    , file_ids=['2026-08-07/reference_library.csv', '2026-08-07/T118.csv'])
