        "code": "\nimport numpy as np\n\nresults = []\n# Order as requested: x=40.0, 40.1, 40.2 for each y=27.0, 27.1, 27.2\ny_coords = [27.0, 27.1, 27.2]\nx_coords = [40.0, 40.1, 40.2]\n\nfor y in y_coords:\n    for x in x_coords:\n        # Find the spectrum for this coordinate\n        spec = None\n        for s in spectra:\n            if abs(s['x'] - x) < 0.01 and abs(s['y'] - y) < 0.01:\n                spec = s\n                break\n        \n        if spec is not None:\n            # Find max peak\n            idx = np.argmax(spec['intensity'])\n            pos = spec['raman_shift'][idx]\n            val = spec['intensity'][idx]\n            results.append({'x': x, 'y': y, 'pos': pos, 'val': val})\n        else:\n            results.append({'x': x, 'y': y, 'pos': None, 'val': None})\n\nprint(\"Grid Results:\")\nfor r in results:\n    print(f\"X={r['x']}, Y={r['y']} -> Pos={r['pos']:.2f}, Int={r['val']:.2f}\")\n"
