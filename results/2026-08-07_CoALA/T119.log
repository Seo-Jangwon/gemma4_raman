    run_analysis(code=import numpy as np
    from scipy.signal import savgol_filter
    from scipy.interpolate import interp1d
    
    # Check data shapes first
    t119_x = files[0]["table"]["raman_shift_cm-1"]
    t119_y = files[0]["table"]["intensity"]
    print(f"T119 shape: {len(t119_x)}")
    
    lib_df = files[1]["table"]
    ref_x_all = lib_df["raman_shift_cm-1"]
    spec_ids = lib_df["spectrum_id"]
    unique_ids = np.unique(spec_ids)
    print(f"Library total rows: {len(ref_x_all)}")
    print(f"Unique spectrum IDs: {len(unique_ids)}")
    
    # Check a single spectrum length
    first_id = unique_ids[0]
    mask = (spec_ids == first_id)
    print(f"Length of spectrum {first_id}: {np.sum(mask)}")
    
    # To be safe, I will iterate through each library spectrum and interpolate T119 to its axis
    y_smoothed = savgol_filter(t119_y, window_length=11, polyorder=3)
    
    def l2_norm(v):
        norm = np.linalg.norm(v)
        return v / norm if norm > 0 else v
    
