    print(f"Saved corrected spectrum to {saved_path}")
    
    # Plot before and after
    plt.figure(figsize=(12, 5))
    
    plt.subplot(1, 2, 1)
    plt.plot(x, y, label='Original', color='blue')
    plt.plot(x, background, label='Background (Poly Order 5)', color='red', linestyle='--')
    plt.title('Original Spectrum & Background Fit')
    plt.xlabel('Raman Shift (cm-1)')
    plt.ylabel('Intensity')
    plt.legend()
    plt.grid(True)
    
    plt.subplot(1, 2, 2)
    plt.plot(x, corrected, label='Corrected', color='green')
    plt.axhline(0, color='black', linewidth=0.8)
    plt.title('Background Subtracted Spectrum')
    plt.xlabel('Raman Shift (cm-1)')
    plt.ylabel('Intensity')
    plt.legend()
    plt.grid(True)
    
    plt.tight_layout()
    plt.show()
    
    print(f"Poly order used: {poly_order}")
    print(f"Max intensity original: {np.max(y):.2f}, Max intensity corrected: {np.max(corrected):.2f}")
