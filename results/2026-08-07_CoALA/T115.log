        y_ref = intensity_ref[mask]
        
        if len(y_ref) == 0: continue
        
        # L2 Normalize reference
        ref_norm = l2_normalize(y_ref)
        
        # Ensure lengths match (target is 1801 pts, ref should be same if axis is 200-2000 step 1)
