    run_analysis(code=import numpy as np
    from scipy import optimize
    
    def ipbsa(x, y, order=5, max_iter=100, tol=1e-3):
        y_fit = np.zeros_like(y)
        coeffs = np.polyfit(x, y, order)
        y_fit = np.polyval(coeffs, x)
        
        for i in range(max_iter):
            # Find points that are peaks (above the current fit)
            # A common IPBSA threshold is based on the standard deviation or a fixed value.
            # Since we want to remove the background, we only use points 'near' or 'below' the fit.
            mask = y <= y_fit + np.std(y - y_fit) * 0.1 # Very simple iterative mask
            # More standard IPBSA: use a threshold and iterate
            # Let's use a more robust version: points significantly above are masked.
            
            # Re-calculating mask based on the 'valley' logic
            # We want to fit the bottom of the spectrum.
            mask = y < (y_fit + np.max(y - y_fit) * 0.1) # Simplified iterative approach
            
            new_coeffs = np.polyfit(x[mask], y[mask], order)
            new_y_fit = np.polyval(new_coeffs, x)
            
            if np.linalg.norm(new_y_fit - y_fit) < tol:
                break
            y_fit = new_y_fit
        return y_fit
    
    # Load T115
    t115_x = files[0]["table"]["raman_shift_cm-1"]
    t115_y = files[0]["table"]["intensity"]
    
    # 1. IPBSA baseline correction order 5
    bg = ipbsa(t115_x, t115_y, order=5)
    corrected_y = t115_y - bg
    
    # Save corrected spectrum
    save_result("T115_corrected.csv", corrected_y, raman_shift=t115_x)
    
    # 2. L2 Normalization
    def l2_norm(v):
        norm = np.linalg.norm(v)
        return v / norm if norm > 0 else v
    
    norm_y = l2_norm(corrected_y)
    
    # 3. Reference library comparison
    # The reference library is in files[1]
    ref_data = files[1]["table"]
    materials = np.unique(ref_data["material"])
    raman_ref = ref_data["raman_shift_cm-1"]
    intensity_ref = ref_data["intensity"]
    
    results = []
    for mat in materials:
        # Extract spectrum for this material (assuming one spectrum per material for simplicity or average)
        mask = ref_data["material"] == mat
        # Find the first matching spectrum index range
        indices = np.where(mask)[0]
        if len(indices) == 0: continue
        
        # The library might have multiple spectra per material, but they usually share the same X axis
        # Let's take the first one that matches our length/axis
        spec_id = ref_data["spectrum_id"][indices[0]]
        mat_mask = ref_data["spectrum_id"] == spec_id
        y_ref = intensity_ref[mat_mask]
        x_ref = raman_ref[mat_mask]
        
        # Ensure length matches T115 (both are 200-2000, step 1)
        if len(y_ref) == len(norm_y):
            # L2 normalize reference spectrum
            y_ref_norm = l2_norm(y_ref)
            # Cosine similarity for normalized vectors is just the dot product
            similarity = np.dot(norm_y, y_ref_norm)
            results.append((mat, similarity))
    
    best_mat = max(results, key=lambda x: x[1])
    print(f"Best match: {best_mat[0]} with similarity {best_mat[1]:.4f}")
    print(f"Corrected intensity range: {corrected_y.min():.2f} to {corrected_y.max():.2f}")
    , file_ids=['2026-08-07/T115.csv', '2026-08-07/reference_library.csv'])
