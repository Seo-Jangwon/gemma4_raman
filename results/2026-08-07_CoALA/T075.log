    run_analysis(code=import numpy as np
    from scipy import stats
    
    def process_session(file_data):
        # Extract columns
        ids = file_data['spectrum_id']
        shifts = file_data['raman_shift_cm-1']
        intensities = file_data['intensity']
        
        unique_ids = np.unique(ids)
        n_spectra = len(unique_ids)
        
        # Assume all spectra have the same shift axis
        axis = shifts[ids == unique_ids[0]]
        spectra_matrix = []
        for uid in unique_ids:
            spectra_matrix.append(intensities[ids == uid])
        
        spectra_matrix = np.array(spectra_matrix) # (n_spectra, n_points)
        mean_spectrum = np.mean(spectra_matrix, axis=0)
        
        # Find peak near 1001 cm-1
        mask = (axis >= 980) & (axis <= 1020)
        peak_idx = np.argmax(mean_spectrum[mask])
        actual_indices = np.where(mask)[0]
        best_idx = actual_indices[peak_idx]
        peak_pos = axis[best_idx]
        
        # Peak intensities for each spectrum at this exact position
        peak_intensities = spectra_matrix[:, best_idx]
        mean_int = np.mean(peak_intensities)
        std_int = np.std(peak_intensities, ddof=1)
        rsd = (std_int / mean_int) * 100 if mean_int != 0 else 0
        
        return mean_spectrum, peak_pos, rsd
    
    # Load files
    data_a = files[0]['table']
    data_b = files[1]['table']
    
    mean_a, pos_a, rsd_a = process_session(data_a)
    mean_b, pos_b, rsd_b = process_session(data_b)
    
    # Cosine similarity
    dot_prod = np.dot(mean_a, mean_b)
    norm_a = np.linalg.norm(mean_a)
    norm_b = np.linalg.norm(mean_b)
    cosine_sim = dot_prod / (norm_a * norm_b) if (norm_a * norm_b) != 0 else 0
    
    print(f"Session A: Peak Pos={pos_a:.3f}, RSD={rsd_a:.3f}%")
    print(f"Session B: Peak Pos={pos_b:.3f}, RSD={rsd_b:.3f}%")
    print(f"Peak Position Diff: {abs(pos_a - pos_b):.3f}")
    print(f"Cosine Similarity: {cosine_sim:.6f}")
    , file_ids=['2026-08-07/T075_a.csv', '2026-08-07/T075_b.csv'])
