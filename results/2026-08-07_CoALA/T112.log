    def ipbsa(x, y, order=5, iterations=10):
        current_y = y.copy()
        for i in range(iterations):
            # Fit polynomial to current_y
            coeffs = np.polyfit(x, current_y, order)
            baseline = np.polyval(coeffs, x)
            # Subtract baseline from original signal
            subbed = y - baseline
            # Mask points that are significantly above the baseline (peaks)
            # Use a simple threshold for masking: 0 since we just want to avoid peaks
