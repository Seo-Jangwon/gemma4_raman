    from scipy.signal import find_peaks
    
    ref_peaks = np.array([620, 795, 1001, 1031, 1155, 1183, 1450, 1583, 1602])
    results = []
    
    for s in spectra:
        x = s["raman_shift"]
        y = s["intensity"]
        pwr = s["power"]
        exp = s["exposure"]
        
        is_saturated = np.any(y >= 60000)
        poly = np.polyfit(x, y, 2)
        baseline = np.polyval(poly, x)
        y_corr = y - baseline
    
        noise_region = (x >= 200) & (x <= 300)
        noise_std = np.std(y_corr[noise_region]) if np.any(noise_region) else 1.0
        
        detected_count = 0
        peak_heights = []
        for rp in ref_peaks:
            mask = (x >= rp - 5) & (x <= rp + 5)
            if np.any(mask):
                seg = y_corr[mask]
                val = np.max(seg)
                peak_heights.append(val)
                if val > 3 * noise_std:
                    detected_count += 1
            else:
                peak_heights.append(0)
        
        peak_perc = detected_count / len(ref_peaks)
        snr = np.max(peak_heights) / noise_std if (peak_heights and noise_std > 0) else 0
    
        results.append({
            "power": pwr, "exposure": exp, "snr": snr, 
