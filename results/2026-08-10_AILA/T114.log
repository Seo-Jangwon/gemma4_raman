    Revised Script:
    ```python
    import numpy as np
    
    # Identification of data tables
    t114_table = None
    ref_table = None
    for f in files:
        if "T114" in f["filename"]:
            t114_table = f["table"]
        elif "reference_library" in f["filename"]:
            ref_table = f["table"]
    
    # T114 preparation
    x_t114 = t114_table['raman_shift_cm-1'].astype(float)
    y_t114 = t114_table['intensity'].astype(float)
    sort_idx = np.argsort(x_t114)
    x_t114 = x_t114[sort_idx]
    y_t114 = y_t114[sort_idx]
    
    # Reference processing
    unique_ids = np.unique(ref_table['spectrum_id'])
    max_sim = -1.0
    best_name = ""
    
    for uid in unique_ids:
        mask = (ref_table['spectrum_id'] == uid)
        x_r = ref_table['raman_shift_cm-1'][mask].astype(float)
        y_r = ref_table['intensity'][mask].astype(float)
        
        # Interpolate T114 onto the reference x-axis (requirement)
        y_t114_interp = np.interp(x_r, x_t114, y_t114)
        
        # L2 Normalize
        norm_ref = y_r / np.linalg.norm(y_r)
        norm_t114 = y_t114_interp / np.linalg.norm(y_t114_interp)
        
        # Cosine Similarity Calculation
        sim = np.dot(norm_ref, norm_t114) # Since normalized, dot is the similarity
        # Note: standard cosine sim allows negative values if orientations are opposite
        # but usually we just care about high positive values.
        
        if sim > max_sim:
            max_sim = sim
            best_name = uid
    
    print(f"Best Match Name: {best_name}")
    print(f"Highest Similarity: {max_sim}")
    ```
    
