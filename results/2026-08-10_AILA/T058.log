    x = data['raman_shift'] # The correct key found in previous step
    
    # 1. Spike removal (5-point moving median, 100x MAD)
    med_val = np.median(y)
    mad_val = np.median(np.abs(y - med_val))
    y_med = medfilt(y, kernel_size=5)
    
    mask = np.abs(y - y_med) > (100 * mad_val)
    y[mask] = y_med[mask]
    
    # 2. IPBSA baseline order 5
    # Note: if ipbsa isn't there, I have to use the fact that it was mentioned in instructions
    corrected, _ = ipbsa(y, order=5)
    
    # 3. Savitzky-Golay (11, 3)
    y_sg = savgol_filter(corrected, window_length=11, polyorder=3)
    
    # 4. 0-1 normalization
    y_norm = (y_sg - np.min(y_sg)) / (np.max(y_sg) - np.min(y_sg))
    
    # Find the top 3 peaks
    p_idx, _ = find_peaks(y_norm)
    # Filter to find indices of highest intensities
    if len(p_idx) >= 3:
        top_indices = p_idx[np.argsort(y_norm[p_idx])[-3:][::-1]]
    else:
        top_indices = p_idx[:3] # Fallback
    
    peaks_to_report = x[top_indices].tolist()
    print(f"Peaks for reporting: {peaks_to_report}")
    
    # Save the processed spectrum
    save_result("processed.csv", y_norm, raman_shift=x)
