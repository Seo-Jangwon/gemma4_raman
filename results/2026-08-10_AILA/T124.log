    def get_avg_spectrum(data, material_name):
        indices = [i for i, m in enumerate(data['material']) if m == material_name]
        if not indices:
            return None
        y_vals = np.array([data['y'][i] for i in indices])
        avg_y = np.mean(y_vals, axis=0)
        if np.max(avg_y) != 0:
            avg_y = avg_y / np.max(avg_y)
        return avg_y
    
    calcite_ref = get_avg_spectrum(ref_data, 'calcite')
    aragonite_ref = get_avg_spectrum(ref_data, 'aragonite')
    
    def calculate_similarity(signal1, signal2):
        if signal2 is None: return -1.0
        s1 = np.array(signal1)
        s2 = np.array(signal2)
        m1, std1 = np.mean(s1), np.std(s1)
        m2, std2 = np.mean(s2), np.std(s2)
        if std1 == 0 or std2 == 0: return 0.0
        norm_s1 = (s1 - m1) / std1
        norm_s2 = (s2 - m2) / std2
        denom = np.linalg.norm(norm_s1) * np.linalg.norm(norm_s2)
        return np.sum(norm_s1 * norm_s2) / denom if denom != 0 else 0.0
    
    score_c = calculate_similarity(t124_data['y'], calcite_ref)
    score_a = calculate_similarity(t124_data['y'], aragonite_ref)
    
    print(f"Score Calcite: {score_c}")
    print(f"Score Aragonite: {score_a}")
    
    if score_c > score_a:
        print("Final Result: calcite")
    elif score_a > score_c:
        print("Final Result: aragonite")
    else:
        print("Final Result: tie")
