        elif "reference_library" in name:
            ref_library_data = f['table']
    
    # Check if we found them (for internal debugging)
    # print(f"T119 Found: {t119_data is not None}")
    # print(f"Ref Library Found: {ref_library_data is not None}")
    
    if t119_data is not None and ref_library_data is not None:
        x_orig = t119_data['raman_shift_cm-1'].values
        y_orig = t119_data['intensity'].values
        
        # Savitzky-Golay (window=11, poly=3)
        y_smooth = savgol_filter(y_orig, 11, 3)
        
        x_ref = np.unique(ref_library_data['raman_shift_cm-1'])
        y_interp = np.interp(x_ref, x_orig, y_smooth)
        
        # L2 Normalize
        norm_val = np.linalg.norm(y_interp)
        if norm_val > 0:
            y_final = y_interp / norm_val
        else:
            y_final = y_interp
            
        materials = np.unique(ref_library_data['material'])
        best_match = ""
        max_score = -1.0
        
        for m in materials:
            m_mask = ref_library_data['material'] == m
            # We'll find the unique x-coordinates for this material and its corresponding intensities.
            # Since multiple entries may exist, we average them if they share an x value.
            # Step 1: create a temporary structure to group by x.
            temp_map = {}
            for _, row in ref_library_data[m_mask].iterrows():
                x_val = row['raman_shift_cm-1']
                y_val = row['intensity']
                if x_val not in temp_map:
                    temp_map[x_val] = []
                temp_map[x_val].append(y_val)
            
            # Step 2: create average intensities for all points on the reference grid.
            y_m_at_ref = []
            for rx in x_ref:
                if rx in temp_map:
                    y_m_at_ref.append(np.mean(temp_map[rx]))
                else:
                    y_m_at_ref.append(0.0)
            
            y_m_at_ref = np.array(y_m_at_ref, dtype=float)
            
            # Step 3: L2 normalize the reference signal to compare with y_final (which is already normalized).
            norm_m = np.linalg.norm(y_m_at_ref)
            if norm_m > 0:
                y_m_comp = y_m_at_ref / norm_m
            else:
                y_m_comp = y_m_at_ref
                
            # Score is the dot product of two unit vectors (cosine similarity).
            score = np.dot(y_final, y_m_comp)
            if score > max_score:
                max_score = score
                best_match = m
        
        print(f"Final Selection: {best_match}")
    else:
        # This part helps debug if files aren't found.
        pass
